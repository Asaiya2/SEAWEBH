-- ---------------- watch list ----------------
local LOOKUP = {}

local IMAGES_N = {}
for name, url in pairs(IMAGES) do IMAGES_N[norm(name)] = url end

local function addEntry(names, tier, minKg, webhook, image)
    if type(names) ~= "table" then names = { names } end
    if not names[1] then return end
    local img = image
    if not img then
        for _, n in ipairs(names) do
            if IMAGES_N[norm(n)] then img = IMAGES_N[norm(n)] break end
        end
    end
    local info = { display = names[1], tier = tier, minKg = minKg or 0, webhook = webhook, image = img }
    for _, n in ipairs(names) do
        local k = norm(n)
        if LOOKUP[k] == nil then LOOKUP[k] = info end
    end
end

for _, c in ipairs(CUSTOM_EGGS) do
    addEntry(c.names, "Custom", c.minKg or MIN_KG.Custom, c.webhook, c.image)
end
for _, tier in ipairs(HOP_FOR) do
    if RARE[tier] then
        for _, entry in ipairs(RARE[tier]) do
            addEntry(entry, tier, MIN_KG[tier], nil, nil)
        end
    end
end

local AUTO_TIERS = { secret = "Secret", eternal = "Eternal", divine = "Divine" }

local function resolve(r)
    local cat = r.AssetCategory or r.Category
    if not cat then return nil end
    local entry = getEntry(cat)

    local keys = { norm(cat) }
    if type(entry) == "table" then
        keys[#keys + 1] = norm(entry.DisplayName)
        keys[#keys + 1] = norm(entry._id)
    end
    for _, k in ipairs(keys) do
        if k ~= "" and LOOKUP[k] then return LOOKUP[k] end
    end

    if AUTO_BY_RARITY and type(entry) == "table" and type(entry.Rarity) == "table" then
        local tier = AUTO_TIERS[norm(entry.Rarity._id or entry.Rarity.DisplayName)]
        if tier then
            local display = tostring(entry.DisplayName or cat)
            return { display = display, tier = tier, minKg = MIN_KG[tier],
                     image = IMAGES_N[norm(display)] }
        end
    end
    return nil
end

-- ---------------- discord ----------------
local function validUrl(u)
    return type(u) == "string" and u:find("/api/webhooks/", 1, true) ~= nil
end

local function post(url, payload)
    if not httpRequest then warn("[EGG KG] No http request function in this executor") return end
    if not validUrl(url) then warn("[EGG KG] Webhook not set or invalid") return end

    for attempt = 1, 4 do
        local ok, res = pcall(httpRequest, {
            Url     = url,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = HttpService:JSONEncode(payload),
        })
        if ok and type(res) == "table" and tonumber(res.StatusCode) == 429 then
            local wait = 1
            pcall(function() wait = tonumber(HttpService:JSONDecode(res.Body).retry_after) or 1 end)
            task.wait(wait + 0.1)
        else
            if not ok then warn("[EGG KG] Send failed: " .. tostring(res)) end
            return
        end
    end
end

local function sendAlert(info, kg, location)
    local style = STYLE[info.tier]
    local roleId = ROLE_IDS[info.tier]
    local mention = (roleId and roleId ~= "") and ("<@&" .. roleId .. "> ") or ""
    local eggName = info.display .. " Egg"

    local desc = "*" .. style.tag .. "*"
    desc = desc .. "\n" .. playerInfoText()

    local kgText = formatKg(kg)
    local link = serverLink()
    local serverValue = link and ("[**Click to Join Server**](" .. link .. ")") or "**Unavailable**"

    local embed = {
        title       = style.emoji .. "  " .. style.title .. "  " .. style.emoji,
        description = desc,
        color       = style.color,
        fields = {
            { name = "🥚 Egg",    value = "**" .. eggName .. "**",    inline = true },
            { name = "💎 Rarity", value = "**" .. info.tier .. "**",  inline = true },
            { name = "🔗 Server", value = serverValue,                inline = true },
            { name = "⚖️ EGG KG", value = "```" .. kgText .. "```",   inline = false },
            { name = "🆔 Job ID", value = "```" .. (game.JobId ~= "" and game.JobId or "N/A") .. "```", inline = false },
            { name = "🔌 Join via executor", value = "```lua\n" .. joinSnippet() .. "\n```", inline = false },
            { name = "📎 Direct link (paste in browser / Win+R)", value = "```" .. deepLink() .. "```", inline = false },
        },
        footer    = { text = FOOTER_TEXT .. " • " .. info.tier .. " Alert" },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time()),
    }
    if info.image and info.image ~= "" then
        embed.thumbnail = { url = info.image }
    end

    post(info.webhook or WEBHOOKS[info.tier], {
        username   = BOT_NAME,
        avatar_url = (BOT_AVATAR ~= "") and BOT_AVATAR or nil,
        content    = mention .. style.emoji .. " **" .. eggName .. "** in this server",
        allowed_mentions = { parse = { "roles" } },
        embeds     = { embed },
    })
end

-- alert queue (keeps us under Discord's rate limit)
local queue = {}
local sendBusy = false

task.spawn(function()
