-- ---------------- kg ----------------
local function eggKg(r)
    if not EggRecords then return nil end
    local ok, kg = pcall(EggRecords.WeightKg, r)
    if ok and type(kg) == "number" then return kg end
    ok, kg = pcall(EggRecords.WeightKgForScale, r.AssetCategory, r.AssetScale)
    if ok and type(kg) == "number" then return kg end
    return nil
end

local KG_SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

local function formatKg(kg)
    if not kg then return "?" end
    local n = math.floor(math.max(kg, 0) + 0.5)
    local i = 1
    while n >= 1000 and i < #KG_SUFFIXES do
        n = n / 1000
        i = i + 1
    end
    if i == 1 then
        return tostring(n) .. " Kg"
    end
    local mult = 10 ^ KG_DECIMALS
    local v = math.floor(n * mult) / mult   -- cuts off, never rounds up
    return string.format("%." .. KG_DECIMALS .. "f", v) .. KG_SUFFIXES[i] .. " Kg"
end

-- ---------------- asset / area names ----------------
local entryCache = {}
local function getEntry(cat)
    cat = tostring(cat or "")
    if cat == "" then return nil end
    local cached = entryCache[cat]
    if cached ~= nil then return cached or nil end

    local entry = assetDir[cat]
    if entry == nil then
        local want = norm(cat)
        for key, e in pairs(assetDir) do
            if type(e) == "table" then
                local egg = type(e.Egg) == "table" and e.Egg or nil
                if norm(key) == want or norm(e._id) == want or norm(e.DisplayName) == want
                    or (egg and norm(egg.ModelName) == want) then
                    entry = e
                    break
                end
            end
        end
    end
    entryCache[cat] = entry or false
    return entry
end

local function areaName(areaId)
    local key = tostring(areaId or "")
    if key == "" then return "" end
    local a = areaDir[key]
    if type(a) == "table" then return tostring(a.DisplayName or key) end
    return key
end

