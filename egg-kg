        local old = workspace:FindFirstChild("EggRarityHunt")
        if old then old:Destroy() end

        local folder = Instance.new("Folder")
        folder.Name = "EggRarityHunt"
        folder.Parent = workspace

        local function value(className, name, val)
            local x = Instance.new(className)
            x.Name = name
            x.Value = val
            x.Parent = folder
            return x
        end

        local vStarted   = value("IntValue", "StartedAt", huntStart or 0)
        value("IntValue", "Duration", RARITY_DURATION)
        value("StringValue", "SelectedRarities", table.concat(HOP_FOR, ", "))
        local vElapsed   = value("IntValue", "Elapsed", huntElapsed())
        local vRemaining = value("IntValue", "Remaining", huntRemaining())
        local vActive    = value("BoolValue", "Active", huntActive())
        local vLast      = value("IntValue", "LastSpawnAt", lastSpawnAt or 0)
        local vSince     = value("IntValue", "SinceLastSpawn", sinceLastSpawn() or -1)

        local part = Instance.new("Part")
        part.Name = "TimerDisplay"
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.Transparency = 1
        part.Size = Vector3.new(1, 1, 1)
