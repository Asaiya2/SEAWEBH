-- ============================================================
-- SERVER HOPPER
-- ============================================================

local targetCount = 0   -- total selected-rarity eggs seen in the last scan.
local firstScanDone = false

local function stopped()
    return type(getgenv) == "function" and getgenv().EGGKG_STOP == true
end

-- ---- visited servers (so we don't go back) ----
local function loadVisited()
    local t = {}
    pcall(function()
        if type(isfile) == "function" and type(readfile) == "function" and isfile(VISITED_FILE) then
            local data = HttpService:JSONDecode(readfile(VISITED_FILE))
            local now = os.time()
            for id, ts in pairs(data) do
                if type(ts) == "number" and now - ts < VISITED_TTL then t[id] = ts end
            end
        end
    end)
    return t
end

local visited = loadVisited()

local function saveVisited()
    if type(writefile) == "function" then
        pcall(writefile, VISITED_FILE, HttpService:JSONEncode(visited))
    end
end

if game.JobId ~= "" then
    visited[game.JobId] = os.time()
    saveVisited()
end

-- ---- server list (emptiest first), saved to a file so each new server can reuse it ----
local pool      = {}          -- server ids, fewest players first
local poolStamp = os.time()   -- when this list was fetched from Roblox
local rateWait  = 5           -- backoff after a rate limit, doubles each time

local function savePool()
    if type(writefile) == "function" then
        pcall(writefile, POOL_FILE, HttpService:JSONEncode({ t = poolStamp, ids = pool }))
    end
end

local function loadPool()
    pcall(function()
        if type(isfile) == "function" and type(readfile) == "function" and isfile(POOL_FILE) then
            local d = HttpService:JSONDecode(readfile(POOL_FILE))
            if type(d) == "table" and os.time() - (tonumber(d.t) or 0) < POOL_TTL then
                poolStamp = tonumber(d.t) or os.time()
                for _, id in ipairs(d.ids or {}) do
                    if not visited[id] and id ~= game.JobId then
                        pool[#pool + 1] = id
                    end
                end
            end
        end
    end)
end

local function fetchServers(cursor)
    if not httpRequest then return nil end
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100",
        game.PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
    if ok and type(res) == "table" and tonumber(res.StatusCode) == 200 then
        local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok2 and type(data) == "table" then return data end
    end
    return nil, (ok and type(res) == "table") and res.StatusCode or nil
end

local function refillPool()
    local cursor
    for _ = 1, SERVER_PAGES do
        local data, status = fetchServers(cursor)
        if not data then
            if tonumber(status) == 429 then
                rateWait = math.min(rateWait * 2, 120)
                warn("[EGG KG] server list rate limited, waiting " .. rateWait .. "s")
                task.wait(rateWait)
            end
            break
        end

        rateWait = 5
        poolStamp = os.time()

        for _, s in ipairs(data.data or {}) do
            local playing, maxP = tonumber(s.playing), tonumber(s.maxPlayers)
            if s.id ~= game.JobId and not visited[s.id] and playing and maxP
                and playing >= MIN_PLAYERS and playing < maxP - 1 then
                pool[#pool + 1] = s.id
            end
        end

        cursor = data.nextPageCursor
        if not cursor then break end
    end
    savePool()
end

loadPool()

-- ---- teleport + hop loop ----
local teleporting, floodUntil = false, 0

TeleportService.TeleportInitFailed:Connect(function(_, result, msg)
    teleporting = false
    warn("[EGG KG] teleport failed: " .. tostring(result) .. " " .. tostring(msg))
    if result == Enum.TeleportResult.Flooded then
        floodUntil = os.clock() + 10
    end
end)

local hopping = false

local function hopLoop()
    hopping = true
    warn("[EGG KG] hunt window active (" .. table.concat(HOP_FOR, ", ") .. "), hopping every " .. HOP_DELAY .. "s")

    -- wait for the first scan so we know what's in this server
    local t0 = os.clock()
    while not firstScanDone and os.clock() - t0 < 40 do task.wait(0.2) end

    -- then let any webhook go out
    t0 = os.clock()
    while (#queue > 0 or sendBusy) and os.clock() - t0 < 20 do task.wait(0.2) end

    while HOP_ENABLED and not stopped() and huntActive() do
        task.wait(HOP_DELAY)
        if not huntActive() then break end

        if os.clock() < floodUntil then task.wait(floodUntil - os.clock()) end
        if #pool == 0 then refillPool() end

        if #pool > 0 then
            local id = table.remove(pool, 1)   -- emptiest server first
            visited[id] = os.time()
            saveVisited()
            savePool()

            teleporting = true
            local tp0 = os.clock()
            local ok, err = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, id, Players.LocalPlayer)
            end)
            if not ok then
                teleporting = false
                warn("[EGG KG] teleport error: " .. tostring(err))
            end
            -- a successful teleport ends this script; wait for a failure or a timeout
            while teleporting and os.clock() - tp0 < 15 do task.wait(0.2) end
            teleporting = false
        else
            warn("[EGG KG] no servers available, retrying")
        end
    end

    hopping = false
    warn("[EGG KG] hopping stopped (window ended or stopped by you), waiting for the next egg")
end

-- starts hopping only while a hunt window is active (after a selected egg was found)
task.spawn(function()
    while true do
        if HOP_ENABLED and not hopping and not stopped() and huntActive() then
            task.spawn(hopLoop)
        end
        task.wait(1)
    end
end)

-- ============================================================
-- SCANNER
-- ============================================================

if type(EggState) ~= "table" or type(EggState.ReadFieldEggs) ~= "function" then
    warn("[EGG KG] EggState.ReadFieldEggs not found, cannot scan. Script stopped.")
    return
end

local seen = {}
local firstScan = true

local function scan()
    local ok, data = pcall(EggState.ReadFieldEggs)
    if not (ok and type(data) == "table") then return end
    local raw = data.Records or data
    if type(raw) ~= "table" then return end

    local now = os.clock()
    local selectedCount = 0

    for key, r in pairs(raw) do
        if type(r) == "table" then
            local uid = tostring(r.Uid or (type(key) == "string" and key) or "")
            local info = resolve(r)

            if info and uid ~= "" then
                if RARE[info.tier] then
                    selectedCount = selectedCount + 1
                end

                local isNew = seen[uid] == nil
                seen[uid] = now

                if isNew and (ALERT_ON_START or not firstScan) then
                    local kg = eggKg(r)
                    if (not kg) or kg >= (info.minKg or 0) then
                        -- a selected egg starts the window (if one isn't already running)
                        if RARE[info.tier] then
                            markSelectedSpawn()
                        end
                        queue[#queue + 1] = { info = info, kg = kg, location = areaName(r.AreaId) }
                        print(string.format("[EGG KG] %s (%s) | %s | %s",
                            info.display, info.tier, formatKg(kg), areaName(r.AreaId)))
                    end
                end
            end
        end
    end

    targetCount = selectedCount
    firstScan = false
    firstScanDone = true

    for uid, t in pairs(seen) do
        if now - t > FORGET_SECONDS then seen[uid] = nil end
    end
end

print("[EGG KG] running. Hopping " .. (HOP_ENABLED and "ON" or "OFF")
    .. " for: " .. table.concat(HOP_FOR, ", ")
    .. ". Custom entries: " .. #CUSTOM_EGGS)

-- runs forever: scan, and close the window when its time is up
while true do
    local ok, err = pcall(scan)
    if not ok then warn("[EGG KG] scan error: " .. tostring(err)) end
    checkHuntExpiry()
    task.wait(SCAN_INTERVAL)
end
