-- ============================================================
-- PERSISTENT HUNT WINDOW
-- ============================================================
-- huntStart is nil while we are idle (waiting for an egg). It is set when
-- a selected egg is found and cleared when RARITY_DURATION has passed.
-- It uses os.time(), not os.clock(), so it survives script re-execution
-- and teleporting between servers.
local huntStart = nil
local lastSpawnAt = nil

local function saveHuntTimer()
    if type(writefile) ~= "function" then return end
    pcall(function()
        writefile(TIMER_FILE, HttpService:JSONEncode({
            startedAt = huntStart,
            lastSpawnAt = lastSpawnAt,
            duration = RARITY_DURATION,
            rarities = HOP_FOR,
        }))
    end)
end

local function loadHuntTimer()
    if type(isfile) ~= "function" or type(readfile) ~= "function" or not isfile(TIMER_FILE) then
        return nil
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(TIMER_FILE))
    end)
    if not ok or type(data) ~= "table" then return nil end

    local startedAt = tonumber(data.startedAt)
    local savedLastSpawn = tonumber(data.lastSpawnAt)
    local oldDuration = tonumber(data.duration)
    if not startedAt or not oldDuration then return nil end

    -- If the selected rarity set changed, ignore the old window.
    local oldRarities = data.rarities
    if type(oldRarities) == "table" then
        local a, b = {}, {}
        for _, v in ipairs(oldRarities) do a[tostring(v)] = true end
        for _, v in ipairs(HOP_FOR) do b[tostring(v)] = true end
        for k in pairs(a) do if not b[k] then return nil end end
        for k in pairs(b) do if not a[k] then return nil end end
    end

    -- A duration change ignores the old window.
    if oldDuration ~= RARITY_DURATION then return nil end
    if os.time() - startedAt >= RARITY_DURATION then return nil end

    lastSpawnAt = savedLastSpawn
    return startedAt
end

local function clearHuntTimerFile()
    if type(delfile) == "function" then
        pcall(delfile, TIMER_FILE)
    end
end

huntStart = loadHuntTimer()
if huntStart then
    print("[EGG KG] resumed hunt window; " .. math.max(0, os.time() - huntStart)
        .. "s of " .. RARITY_DURATION .. "s has already elapsed")
else
    print("[EGG KG] idle, waiting for a selected egg")
end

local function huntElapsed()
    if not huntStart then return 0 end
    return math.max(0, os.time() - huntStart)
end

local function huntRemaining()
    if not huntStart then return 0 end
    return math.max(0, RARITY_DURATION - huntElapsed())
end

local function huntActive()
    return huntStart ~= nil and huntRemaining() > 0
end

local function sinceLastSpawn()
    if not lastSpawnAt then return nil end
    return math.max(0, os.time() - lastSpawnAt)
end

-- starts a new window, but only if one is not already running
local function startHunt()
    if huntActive() then return end
    huntStart = os.time()
    saveHuntTimer()
    print("[EGG KG] selected egg found, started a " .. RARITY_DURATION .. "s window")
end

local function markSelectedSpawn()
    lastSpawnAt = os.time()
    startHunt()
    saveHuntTimer()
end

-- ends the window once the time is up and goes back to waiting
local function checkHuntExpiry()
    if huntStart and not huntActive() then
        huntStart = nil
        clearHuntTimerFile()
        print("[EGG KG] window ended, waiting for the next selected egg")
    end
end

