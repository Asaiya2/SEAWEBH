local lastButterflyAt = 0

local function sendButterflyEmbed(startedAt, duration)
    local endsAt = startedAt + duration

    postWebhook(BUTTERFLY_WEBHOOK, {
        username   = BOT_NAME,
        avatar_url = (BOT_AVATAR ~= "") and BOT_AVATAR or nil,
        content    = "<@&" .. BUTTERFLY_ROLE_ID .. "> **Butterfly Bloom** just started!",
        allowed_mentions = { roles = { BUTTERFLY_ROLE_ID } },
        embeds = {{
            title       = "🦋  BUTTERFLY BLOOM ACTIVE  🦋",
            description = "*A swarm of butterflies roam the servers*",
            color       = 0xFF69B4,
            thumbnail   = { url = BUTTERFLY_IMAGE },
            fields = {
                { name = "🦋 Event",     value = "**Butterfly Bloom**", inline = true },
                { name = "✅ Status",    value = "**Active**",          inline = true },
                { name = "⏱️ Started",   value = "**<t:" .. startedAt .. ":R>**", inline = true },
                { name = "⏳ TIME LEFT", value = "**Disappears <t:" .. endsAt .. ":R>** (<t:" .. endsAt .. ":t>)", inline = false },
            },
            footer    = { text = "https://discord.gg/W0RST • Secret Alert" },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time()),
        }},
    }, true)
end

local function onButterflyBegan(name, duration)
    if tostring(name) ~= BUTTERFLY_EVENT then
        return
    end

    -- NEW: remember when the event ends so the feed reports it as running.
    -- This happens BEFORE the cooldown check so the board is always correct.
    local dur = tonumber(duration) or BUTTERFLY_DEFAULT_DURATION
    butterflyEndsAt = os.time() + dur

    local now = os.time()
    if now - lastButterflyAt < BUTTERFLY_COOLDOWN then
        print("[Butterfly] skipped (cooldown)")
        return
    end
    lastButterflyAt = now

    sendButterflyEmbed(now, dur)
    print("[Butterfly] alert sent")
end

local function hookButterfly(remote)
    if remote:IsA("RemoteEvent") and remote.Name == "RE/LiveEvents/Began" then
        remote.OnClientEvent:Connect(onButterflyBegan)
        print("[Butterfly] hooked " .. remote:GetFullName())
    end
end

