-- ============================================================
-- FIXED BUILD SNAPSHOT
-- ============================================================
-- Main source: EggState.ReadFieldEggs()
-- Fallback: AreaEggSlotsClient
--
-- The fallback is what was added for eggs that aren't being
-- returned by ReadFieldEggs(), such as the Angels/Demons if
-- their physical slots are present there.
--
-- Returns: counts, ids, ok, eggs
--   eggs = one entry per egg that exists right now (used by the
--   rare egg alerts): { uid, k, nameKey, catKey, areaId }
-- ============================================================

local function buildSnapshot()
    local counts, ids, eggs = {}, {}, {}

    local ok, es = pcall(function()
        return require(RS.Client.EggState)
    end)

    if not (ok and es) then
        return counts, ids, false, eggs
    end

    local records = {}

    -- ========================================================
    -- SOURCE 1: EggState.ReadFieldEggs()
    -- ========================================================

    local ok2, data = pcall(es.ReadFieldEggs)

    if ok2 and type(data) == "table" then
        local raw = data.Records or data

        if type(raw) == "table" then
            for key, r in pairs(raw) do
                if type(r) == "table" then

                    if not r.Uid and type(key) == "string" then
                        r.Uid = key
                    end

                    table.insert(records, r)
                end
            end
        end
    end


    -- ========================================================
    -- SOURCE 2: AreaEggSlotsClient
    -- ========================================================

    local slotsFolder = workspace:FindFirstChild("AreaEggSlotsClient")

    if slotsFolder then
        local seenUid = {}
        for _, existing in ipairs(records) do
            local eu = tostring(existing.Uid or "")
            if eu ~= "" then
                seenUid[eu] = true
            end
        end

        local function scanSlots(container)
            for _, slot in ipairs(container:GetChildren()) do
                if slot:IsA("Folder") or slot:IsA("Model") then
                    scanSlots(slot)
                end

                local uid = slot.Name
                if uid and uid ~= "" and not seenUid[tostring(uid)] then
                    local category =
                        slot:GetAttribute("Category")
                        or slot:GetAttribute("AssetCategory")

                    if category and category ~= "" then
                        local areaId =
                            slot:GetAttribute("AreaId")
                            or slot:GetAttribute("Area")

                        table.insert(records, {
                            Uid = uid,
                            AssetCategory = category,
                            AreaId = areaId,
                            State = "Slot",
                            PhysicalModel = slot,
                        })
                        seenUid[tostring(uid)] = true
                    end
                end
            end
        end

        scanSlots(slotsFolder)
    end

    -- ========================================================
    -- PROCESS RECORDS
    -- ========================================================

    for _, r in ipairs(records) do

        local uid = tostring(r.Uid or "")

        local category =
            r.AssetCategory
            or r.Category

        local info = category and getAssetInfo(category) or nil
        local name = info and info.Name or category

        if DEBUG_PRINT then
            print(
                "[EGG DEBUG]",
                "UID =", uid,
                "Category =", tostring(category),
                "Name =", tostring(name),
                "AreaId =", tostring(r.AreaId),
                "Area =", getAreaDisplayName(r.AreaId),
                "State =", tostring(r.State)
            )
        end

        if name
            and not (IGNORE_FIRST_AREA and uid:find("FirstArea"))
        then

            local k = norm(name)

            -- Prefer the game's resolved DisplayName. If the catalog
            -- has a legacy/internal alias, fall back to AssetCategory.
            k = ALIASES[k] or ALIASES[norm(category)] or k

            counts[k] = (counts[k] or 0) + 1

            local id

            if uid ~= "" then
                id = uid .. "|" .. k
            else
                id = k .. "#" .. counts[k]
            end

            ids[id] = true

            eggs[#eggs + 1] = {
                uid     = uid,
                k       = k,
                nameKey = norm(name),
                catKey  = category and norm(category) or "",
                areaId  = r.AreaId,
            }
        end
    end

    if DEBUG_PRINT then
        local total = 0
        for _, n in pairs(counts) do
            total = total + n
        end
        print("[EGG DEBUG] records:", #records, "counted:", total)
        for k, n in pairs(counts) do
            print("[EGG DEBUG] count", k, n)
        end
    end

    return counts, ids, true, eggs
end


-- ============================================================
-- RARE EGG DETECTOR
-- Runs on every scan of the feed loop. Every rare egg that exists gets
-- exactly one alert (tracked by its unique id). Alerts go through a small
-- queue so a burst of rare eggs doesn't hit Discord's rate limit; the first
-- alert is sent immediately.
-- ============================================================

local alertQueue = {}

task.spawn(function()
    while true do
        local a = table.remove(alertQueue, 1)

        if a then
            pcall(sendEggEmbed, a.name, a.tier, a.location)
            task.wait(ALERT_SEND_GAP)
        else
            task.wait(0.05)
        end
    end
end)

local alerted       = {}    -- uid -> last time this egg was seen (os.clock)
local alertedNoUid  = {}    -- egg name -> how many uid-less copies were already alerted
local firstRareScan = true

local function checkRare(eggs)
    local now = os.clock()
    local noUidNow = {}

    for _, e in ipairs(eggs) do
        local info = RARE_INFO[e.k] or RARE_INFO[e.nameKey] or RARE_INFO[e.catKey]

        if info then
            local isNew = false

            if e.uid ~= "" then
                if alerted[e.uid] == nil then
                    isNew = true
                end
                alerted[e.uid] = now
            else
                -- no unique id: count copies instead (2 Stags = 2 alerts)
                local n = (noUidNow[info.name] or 0) + 1
                noUidNow[info.name] = n

                if n > (alertedNoUid[info.name] or 0) then
                    alertedNoUid[info.name] = n
                    isNew = true
                end
            end

            if isNew and (ALERT_EXISTING_ON_START or not firstRareScan) then
                local location = ZONE_OF[e.k] or ZONE_OF[e.nameKey] or getAreaDisplayName(e.areaId)

                alertQueue[#alertQueue + 1] = {
                    name     = info.name,
                    tier     = info.tier,
                    location = location,
                }

                print("[EGG] rare spotted:", info.name, "(" .. info.tier .. ")")
            end
        end
    end

    firstRareScan = false

    -- forget eggs that have been gone for a while
    for uid, seenAt in pairs(alerted) do
        if now - seenAt > ALERT_FORGET_SECONDS then
            alerted[uid] = nil
        end
    end

    for name in pairs(alertedNoUid) do
        if not noUidNow[name] then
            alertedNoUid[name] = nil
        end
    end
end


-- ============================================================
-- DR. SCRAMBLE BANNER READER
-- Reads the current banner from the game's own GUI:
--   PlayerGui.DrScrambleTradeIn.DrScrambleTradeInMain.CurrentEggInfoHolder.EggName
-- Returns: name ("Experimental Pets"), secondsLeft (or nil)
-- ============================================================

local function cleanText(s)
    local r = tostring(s):gsub("<[^>]->", "")
    r = r:gsub("^%s+", ""):gsub("%s+$", "")
    return r
end

local function readScramble()
    local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
    local gui = pg and pg:FindFirstChild("DrScrambleTradeIn")
    local main = gui and gui:FindFirstChild("DrScrambleTradeInMain")
    local holder = main and main:FindFirstChild("CurrentEggInfoHolder")
    if not holder then
        return nil
    end

    local nameLabel = holder:FindFirstChild("EggName")
    if not (nameLabel and nameLabel:IsA("TextLabel")) then
        return nil
    end

    -- "Experimental Pets Banner" -> "Experimental Pets"
    local name = cleanText(nameLabel.Text)
    name = name:gsub("%s*Banner%s*$", "")
    if name == "" then
        return nil
    end

    -- optional: "Rotates in: 50m 42s" -> seconds
    local left = nil
    for _, obj in ipairs(holder:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local t = cleanText(obj.Text)
            if t:lower():find("rotates in") then
                local h = tonumber(t:match("(%d+)%s*h")) or 0
                local m = tonumber(t:match("(%d+)%s*m")) or 0
                local s = tonumber(t:match("(%d+)%s*s")) or 0
                if h + m + s > 0 then
                    left = h * 3600 + m * 60 + s
                end
                break
            end
        end
    end

    return name, left
end


-- ============================================================
-- BUTTERFLY BLOOM STATE  (NEW)
-- Shared between the event hook (Part 3) and the feed (Part 2).
-- Part 3 sets butterflyEndsAt when the event begins; the feed
-- reads it so the bot knows the event is running.
-- ============================================================

local butterflyEndsAt = nil   -- os.time() when the event ends, nil = not running

local function butterflyLeft()
    if butterflyEndsAt then
        local left = butterflyEndsAt - os.time()
        if left > 0 then
            return left
        end
        butterflyEndsAt = nil
    end
    return nil
end


-- cycleAge = seconds since the current egg cycle started (nil until a cycle
-- has been seen). The bot uses it for the "Next update" countdown.
local function sendFeed(counts, cycleAge)
    local data = {}

    for k, v in pairs(counts) do
        data[k] = v
    end

    if cycleAge then
        data._age = cycleAge
    end

    -- Dr. Scramble current banner (optional, skipped if the GUI isn't found)
    local okS, scrambleName, scrambleLeft = pcall(readScramble)
    if okS and scrambleName then
        data._scramble = scrambleName
        if scrambleLeft then
            data._scramble_left = scrambleLeft
        end
    end

    -- Butterfly Bloom (NEW): tell the bot the event is running and how long is left
    local bLeft = butterflyLeft()
    if bLeft then
        data._butterfly = 1
        data._butterfly_left = bLeft
    end

    local body = "EGGDATA" .. HttpService:JSONEncode(data)

    if #body > 1990 then
        warn("[EGG FEED] payload too long (" .. #body .. " chars)")
        return
    end

    postWebhook(FEED_WEBHOOK, {
        username = "egg-feed",
        content  = body,
    })
end

local function copyCounts(t)
    local c = {}
    for k, v in pairs(t) do
        c[k] = v
    end
    return c
end

local function signature(t)
    local parts = {}

    for k, n in pairs(t) do
        parts[#parts + 1] = k .. ":" .. n
    end

    table.sort(parts)

    return table.concat(parts, "|")
end

local function diffIds(a, b)
    local gone, fresh = 0, 0

    for id in pairs(a) do
        if not b[id] then
            gone = gone + 1
        end
    end

    for id in pairs(b) do
        if not a[id] then
            fresh = fresh + 1
        end
    end

    return gone, fresh
end

local function zonesComplete(counts)
    local perZone, unmapped = {}, 0

    for k, n in pairs(counts) do
        local zone = ZONE_OF[k]

        if zone then
            perZone[zone] = (perZone[zone] or 0) + n
        else
            unmapped = unmapped + n
        end
    end

    local shortBy = 0

    for _, zone in ipairs(NORMAL_ZONES) do
        shortBy = shortBy + math.max(
            0,
            EGGS_PER_ZONE - (perZone[zone] or 0)
        )
    end

    return shortBy <= unmapped
end


-- ============================================================
-- FEED LOOP
-- ============================================================

task.spawn(function()
    local latched, cycleStart = {}, nil
    local windowIds, windowAt = nil, 0
    local settling, settleStart = false, 0
    local lastSig, lastSentAt = nil, 0

    -- new-cycle detector (for the countdown)
    local refIds, refAt, rerollAt = nil, 0, nil

    while true do

        pcall(function()

            local live, ids, ok, eggs = buildSnapshot()

            if not ok then
                return
            end

            -- Rare egg alerts: checked on every scan, before any of the
            -- feed's settling/latching logic, so they are never delayed.
            local okR, errR = pcall(checkRare, eggs)
            if not okR then
                warn("[EGG] rare check failed: " .. tostring(errR))
            end

            local now = os.clock()

            -- --------------------------------------------------
            -- NEW-CYCLE DETECTOR
            -- Compares the current eggs with a snapshot that is at
            -- most CYCLE_REF_SECS old. CYCLE_NEW_EGGS or more brand
            -- new eggs = the eggs just rerolled -> start the timer.
            -- --------------------------------------------------
            if refIds == nil then
                refIds, refAt = ids, now
            else
                local _, fresh = diffIds(refIds, ids)

                if fresh >= CYCLE_NEW_EGGS
                    and (rerollAt == nil or now - rerollAt > CYCLE_MIN_GAP)
                then
                    rerollAt = now
                    refIds, refAt = ids, now
                    print("[EGG] new egg cycle detected")
                elseif now - refAt >= CYCLE_REF_SECS then
                    refIds, refAt = ids, now
                end
            end

            if windowIds == nil then

                windowIds, windowAt = ids, now
                latched, cycleStart = copyCounts(live), now

            else

                local gone, fresh = diffIds(windowIds, ids)

                -- only NEW eggs appearing starts a new cycle. Eggs disappearing
                -- (the game clears the field ~10s before the reroll) is ignored,
                -- so the board keeps showing the old eggs until the new ones spawn.
                local bigChange = fresh >= RESET_IF_CHANGED

                local locked =
                    cycleStart ~= nil
                    and (now - cycleStart) < REROLL_LOCKOUT

                if bigChange and not locked then

                    latched, cycleStart = copyCounts(live), now
                    settling, settleStart = true, now
                    windowIds, windowAt = ids, now

                else

                    for k, n in pairs(live) do
                        if n > (latched[k] or 0) then
                            latched[k] = n
                        end
                    end

                    if now - windowAt >= WINDOW_SECONDS then
                        windowIds, windowAt = ids, now
                    end
                end
            end

            local justSettled = false

            if settling then

                if zonesComplete(latched)
                    or (now - settleStart) >= SETTLE_TIMEOUT
                then
                    settling, justSettled = false, true
                else
                    return
                end
            end

            local latchActive =
                LATCH_ENABLED
                and cycleStart ~= nil
                and (now - cycleStart) < LATCH_SECONDS

            local shown = latchActive and latched or live
            local sig   = signature(shown)

            -- Include the Dr. Scramble banner in the signature so a banner
            -- change is sent right away instead of waiting for the heartbeat.
            local okB, bannerName = pcall(readScramble)
            if okB and bannerName then
                sig = sig .. "|scramble:" .. bannerName
            end

            -- Butterfly Bloom (NEW): start/stop of the event is sent right away too.
            if butterflyLeft() then
                sig = sig .. "|butterfly:1"
            end

            local changed = sig ~= lastSig
            local beat    = (now - lastSentAt) >= HEARTBEAT

            if (
                (changed or justSettled)
                and (now - lastSentAt) >= MIN_SEND_GAP
            ) or beat then

                lastSig    = sig
                lastSentAt = now

                sendFeed(shown, rerollAt and math.floor(now - rerollAt) or nil)
            end
        end)

        task.wait(CHECK_INTERVAL)
    end
end)


