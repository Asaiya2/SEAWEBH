-- ============================================================
--  NAME FORMATTER
-- ============================================================

local function stripTags(text)

    return text:gsub("<[^>]->", "")

end


local function prettyName(name)

    return name:gsub("(%a)([%w']*)", function(a, b)

        return a:upper() .. b:lower()

    end)

end


-- ============================================================
--  PARSE EGG MESSAGE
--
--  Example:
--
--  "A Divine Unicorn Egg spawned in Titan Temple"
--
--  becomes:
--
--  eggName = "unicorn"
--  tier    = "Divine"
-- ============================================================

local function parseEggMessage(clean)

    local rarity, eggName =
        clean:match(
            "[Aa]n?%s+(%a+)%s+(.-)%s+spawned%s+in"
        )

    if not rarity or not eggName then
        return nil
    end


    rarity = rarity:lower()


    if rarity ~= "secret"
        and rarity ~= "eternal"
        and rarity ~= "divine" then

        return nil

    end


    eggName =
        eggName
        :lower()
        :gsub("%s+$", "")


    eggName =
        eggName:gsub("%s+egg$", "")


    local tier = EGG_LOOKUP[eggName]


    if not tier then
        return nil
    end


    return eggName, tier

end


