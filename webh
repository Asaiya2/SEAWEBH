-- ============================================================
--  BUILD STATUS
-- ============================================================

local function buildStatus()

    local byZone = {}


    local ok, es =
        pcall(function()

            return require(
                RS.Client.EggState
            )

        end)


    if ok and es then

        local ok2, data =
            pcall(
                es.ReadFieldEggs
            )


        if ok2
            and type(data) == "table" then


            for _, r in pairs(
                data.Records or data
            ) do


                if type(r) == "table" then


                    local uid =
                        tostring(
                            r.Uid or ""
                        )


                    local name =
                        r.AssetCategory
                        or r.Category


                    if name
                        and not (
                            IGNORE_FIRST_AREA
                            and uid:find("FirstArea")
                        ) then


                        local k =
                            norm(name)


                        local zone =
                            r.AreaId
                            and tostring(r.AreaId)
                            or ZONE_OF[k]


                        if zone
                            and not isRare(k) then


                            byZone[zone] =
                                byZone[zone]
                                or {}


                            local e =
                                byZone[zone][k]


                            if not e then

                                e = {
                                    name = pretty(name),
                                    count = 0
                                }


                                byZone[zone][k] =
                                    e

                            end


                            e.count += 1

                        end

                    end

                end

            end

        end

    end


    local order = {}
    local used = {}


    for _, z in ipairs(ZONE_ORDER) do

        order[#order + 1] = z
        used[z] = true

    end


    local extra = {}


    for z in pairs(byZone) do

        if not used[z] then
            extra[#extra + 1] = z
        end

    end


    table.sort(extra)


    for _, z in ipairs(extra) do
        order[#order + 1] = z
    end


    local zones = {}
    local total = 0
    local sig = {}


    for _, z in ipairs(order) do

        local map =
            byZone[z]


        if map then

            local list = {}


            for _, e in pairs(map) do

                list[#list + 1] = e

                total += 1

                sig[#sig + 1] =
                    z
                    .. ":"
                    .. e.name
                    .. ":"
                    .. e.count

            end


            table.sort(
                list,
                function(a, b)
                    return a.name < b.name
                end
            )


            if #list > 0 then

                zones[#zones + 1] = {
                    name = z,
                    eggs = list
                }

            end

        end

    end


    table.sort(sig)


    return
        zones,
        total,
        table.concat(sig, "|")

end


-- ============================================================
--  SEND STATUS
-- ============================================================

local function sendStatus(zones, total)

    local fields = {}


    local blank = {
        name = "\u{200B}",
        value = "\u{200B}",
        inline = true
    }


    for i, z in ipairs(zones) do

        local lines = {}


        for _, e in ipairs(z.eggs) do

            lines[#lines + 1] =
                "🟢 "
                .. e.name
                .. (
                    e.count > 1
                    and (" x" .. e.count)
                    or ""
                )

        end


        local value =
            table.concat(
                lines,
                "\n"
            )


        if #value > 1024 then

            value =
                value:sub(1, 1020)
                .. "…"

        end


        fields[#fields + 1] = {

            name = "[" .. z.name .. "]",

            value = value,

            inline = true

        }


        if i % 2 == 0 then
            fields[#fields + 1] = blank
        end

    end


    if #zones % 2 == 1 then

        fields[#fields + 1] = blank
        fields[#fields + 1] = blank

    end


    -- Rarity alert links

    for _, tier in ipairs({
        "Secret",
        "Eternal",
        "Divine"
    }) do


        local link =
            CHANNEL_LINKS[tier]


        local value =
            (
                type(link) == "string"
                and link:find("^https?://")
            )
            and (
                "[View alerts]("
                .. link
                .. ")"
            )
            or "—"


        fields[#fields + 1] = {

            name =
                "["
                .. tier
                .. "]",

            value = value,

            inline = true

        }

    end


    local now = os.time()


    postWebhook(
        WEBHOOKS.Status,
        {

            username =
                STATUS_BOT_NAME,


            avatar_url =
                (STATUS_BOT_AVATAR ~= "")
                and STATUS_BOT_AVATAR
                or nil,


            embeds = {{

                title =
                    "🥚 Egg Status",


                description =
                    string.format(
                        "🟢 **%d ON**  ·  updated <t:%d:R>",
                        total,
                        now
                    ),


                color =
                    0x2ECC71,


                fields =
                    fields,


                footer = {
                    text =
                        "https://discord.gg/Hk7QN5un5k"
                },


                timestamp =
                    os.date(
                        "!%Y-%m-%dT%H:%M:%SZ",
                        now
                    ),

            }},

        }
    )

end


