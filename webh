        await self.switch(interaction, "Secret")


class EggAlerts(commands.Cog):
    def __init__(self, bot):
        self.bot = bot
        self.db = sqlite3.connect(DB_PATH)
        self.db.execute(
            """CREATE TABLE IF NOT EXISTS egg_alerts (
                   guild_id INTEGER, user_id INTEGER, egg TEXT, created_at REAL,
                   PRIMARY KEY (guild_id, user_id, egg))""")
        self.db.execute(
            """CREATE TABLE IF NOT EXISTS egg_last_seen (
                   guild_id INTEGER, egg TEXT, seen_at REAL,
                   PRIMARY KEY (guild_id, egg))""")
        # per-server settings for the Secret / Eternal / Divine notifications
        self.db.execute(
            """CREATE TABLE IF NOT EXISTS egg_rare_cfg (
                   guild_id   INTEGER,
                   tier       TEXT,
                   channel_id INTEGER,
                   role_id    INTEGER,
                   PRIMARY KEY (guild_id, tier))""")
        # Last Seen is now shared by every server. Fold the old per-server rows into one global set.
        if self.db.execute("SELECT 1 FROM egg_last_seen WHERE guild_id = ? LIMIT 1", (GLOBAL_ID,)).fetchone() is None:
            self.db.execute(
                """INSERT OR REPLACE INTO egg_last_seen (guild_id, egg, seen_at)
                   SELECT ?, egg, MAX(seen_at) FROM egg_last_seen GROUP BY egg""", (GLOBAL_ID,))
        self.db.commit()
        self._prev = None   # set of egg display names that were live in the previous feed

    async def cog_unload(self):
        self.db.close()

    # ---------- small helpers ----------
    def _egg_cog(self):
        return self.bot.get_cog("EggStatus")

    def _row(self, guild_id):
        cog = self._egg_cog()
        return cog._get(guild_id) if cog else None

    def _board_channel(self, guild_id):
        row = self._row(guild_id)
        if not row or not row["board_channel_id"]:
            return None
        return self.bot.get_channel(row["board_channel_id"])

    @staticmethod
    def _live_from(counts):
        return {e["display"] for e in EGGS if any(counts.get(k, 0) > 0 for k in e["keys"])}

    def _live_set(self, guild_id):
        """Eggs live right now, or None if the feed is offline / has no data."""
        cog = self._egg_cog()
        feed = cog._feed() if cog else {}
        if not feed.get("counts") or not feed.get("updated_at"):
            return None
        if time.time() - feed["updated_at"] > OFFLINE_AFTER:
            return None
        return self._live_from(json.loads(feed["counts"]))

    def _emoji(self, egg):
        try:
            cog = self._egg_cog()
            by_name, by_norm = cog._emoji_maps()
            return cog._emoji_for(egg["display"], egg["keys"], by_name, by_norm)[0]
        except Exception:
            return "🥚"

    def _last_seen_ts(self, guild_id, display):
        """Last Seen is shared by every server, so guild_id is not used."""
        vals = []
        if display in HARD_TS:
            vals.append(HARD_TS[display])
        r = self.db.execute("SELECT seen_at FROM egg_last_seen WHERE guild_id = ? AND egg = ?",
                            (GLOBAL_ID, display)).fetchone()
        if r:
            vals.append(r[0])
        return max(vals) if vals else None

    def _seen_text(self, guild_id, egg):
        live = self._live_set(guild_id)
        if live and egg["display"] in live:
            return "🟢 **Available now**"
        ts = self._last_seen_ts(guild_id, egg["display"])
        if ts is None:
            return "No data yet"
        # <t:..:R> keeps counting up on its own in Discord; the code text is the exact time when sent
        return f"**<t:{int(ts)}:R>**\n`{fmt_elapsed(time.time() - ts)}`"

    @staticmethod
    def _ambiguous_text(query, eggs):
        names = ", ".join(f"**{e['display']}**" for e in eggs)
        example = eggs[0]["display"].replace(" ", "_")
        return (f'More than one egg matches "{query}": {names}.\n'
                f"Use the full name, e.g. `!alert_{example}`")

    # ---------- rare egg settings (per server) ----------
    def _get_cfg(self, guild_id, tier):
        r = self.db.execute("SELECT channel_id, role_id FROM egg_rare_cfg WHERE guild_id = ? AND tier = ?",
                            (guild_id, tier)).fetchone()
        return {"channel_id": r[0], "role_id": r[1]} if r else {"channel_id": None, "role_id": None}

    def _set_cfg(self, guild_id, tier, **fields):
        cfg = self._get_cfg(guild_id, tier)
        cfg.update(fields)
        if cfg["channel_id"] is None and cfg["role_id"] is None:
            self.db.execute("DELETE FROM egg_rare_cfg WHERE guild_id = ? AND tier = ?", (guild_id, tier))
        else:
            self.db.execute(
                "INSERT OR REPLACE INTO egg_rare_cfg (guild_id, tier, channel_id, role_id) VALUES (?, ?, ?, ?)",
                (guild_id, tier, cfg["channel_id"], cfg["role_id"]))
        self.db.commit()

    # ---------- feed hook (called from EggStatus.on_message, once per feed message) ----------
    async def on_feed(self, counts):
        live = self._live_from(counts)
        prev = self._prev
        self._prev = live

        now = time.time()
        # Record the time an egg FIRST appears in a cycle, not every feed tick.
        # On startup, currently-live eggs become the new baseline and reset to now.
        appeared = live if prev is None else (live - prev)
        if appeared:
            self.db.executemany("INSERT OR REPLACE INTO egg_last_seen (guild_id, egg, seen_at) VALUES (?, ?, ?)",
                                [(GLOBAL_ID, d, now) for d in appeared])
            self.db.commit()

        if prev is None:      # first data since the bot started = baseline, don't ping
            return
        new = live - prev     # eggs that just appeared
        if not new:
            return

        cog = self._egg_cog()
        for gid in (cog._board_guild_ids() if cog else []):
            try:
                await self._send_user_alerts(gid, new)
            except Exception as e:
                print(f"[EGG] user alerts failed for server {gid}: {e}")
            try:
                await self._send_rare_pings(gid, new)
            except Exception as e:
                print(f"[EGG] rare pings failed for server {gid}: {e}")

    async def _send_user_alerts(self, guild_id, new):
        channel = self._board_channel(guild_id)
        if channel is None:
            return
        for display in new:
            rows = self.db.execute("SELECT user_id FROM egg_alerts WHERE guild_id = ? AND egg = ?",
                                   (guild_id, display)).fetchall()
            if not rows:
                continue
            mentions = " ".join(f"<@{r[0]}>" for r in rows)
            emoji = self._emoji(EGG_BY_DISPLAY[display])
            try:
                await channel.send(f"🔔 {mentions} - {emoji} **{display}** is available now!",
                                   delete_after=PING_LIFETIME,
                                   allowed_mentions=discord.AllowedMentions(users=True))
            except discord.HTTPException as e:
                print(f"[EGG] alert ping failed: {e}")
                continue
            self.db.execute("DELETE FROM egg_alerts WHERE guild_id = ? AND egg = ?", (guild_id, display))
            self.db.commit()

    async def _send_rare_pings(self, guild_id, new):
        """Secret / Eternal / Divine notifications for one server."""
        for tier in ("Divine", "Eternal", "Secret"):
            cfg = self._get_cfg(guild_id, tier)
            if cfg["channel_id"] is None and cfg["role_id"] is None:
                continue
            eggs = [d for d in new if d in RARE and RARE[d][0] == tier]
            if not eggs:
                continue
            eggs.sort(key=_rare_value, reverse=True)

            # the tier's own channel; if it isn't set (or is gone) use the board channel
            channel = self.bot.get_channel(cfg["channel_id"]) if cfg["channel_id"] else None
            if channel is None:
                channel = self._board_channel(guild_id)
            if channel is None:
                continue

            color, tier_emoji = TIER_STYLE[tier]
            lines = []
            for display in eggs:
                emoji = self._emoji(EGG_BY_DISPLAY[display])
                lines.append(f"{emoji} **{display}**  —  `{RARE[display][1]}`")
            embed = discord.Embed(
                title=f"{tier_emoji}  {tier} egg spawned!  {tier_emoji}",
                description="\n".join(lines) + "\n\n🟢 **Available now**",
                colour=color)
            thumb = RARE[eggs[0]][2]
            if thumb:
                embed.set_thumbnail(url=thumb)

            content = f"<@&{cfg['role_id']}>" if cfg["role_id"] else None
            try:
                await channel.send(content=content, embed=embed,
                                   delete_after=RARE_PING_LIFETIME,
                                   allowed_mentions=discord.AllowedMentions(roles=True))
            except discord.HTTPException as e:
                print(f"[EGG] {tier} ping failed in server {guild_id}: {e}")

    # ---------- command logic (shared by !alert x and !alert_x) ----------
    async def _handle_alert(self, channel, guild, author, query):
        if not query:
            await channel.send("Usage: `!alert_penguin`")
            return
        status, data = find_eggs(query)
        if status == "none":
            await channel.send(f'I couldn\'t find an egg called "{query}". alert not created.')
            return
        if status == "typo":
            await channel.send(f'Did you misspell "{data}"? alert not created.')
            return
        if len(data) > 1:
            await channel.send(self._ambiguous_text(query, data) + "\nalert not created.")
            return

        egg = data[0]
        display = egg["display"]
        cur = self.db.execute(
            "INSERT OR IGNORE INTO egg_alerts (guild_id, user_id, egg, created_at) VALUES (?, ?, ?, ?)",
            (guild.id, author.id, display, time.time()))
        self.db.commit()
        if cur.rowcount == 0:
            await channel.send(f"{author.mention} you already have an alert for **{display}**.")
            return

        board = self._board_channel(guild.id)
        where = board.mention if board else "the egg board channel"
        msg = f"🔔 Rest assured {author.mention}, I will ping you when **{display}** is available in {where}"
        if display in (self._live_set(guild.id) or set()):
            msg += "\n*(It's live right now, so I'll ping you the next time it shows up.)*"
        await channel.send(msg)

    async def _handle_value(self, channel, guild, query):
        if not query:
            await channel.send("Usage: `!value_kraken`")
            return
        status, data = find_eggs(query)
        if status == "none":
            await channel.send(f'I couldn\'t find an egg called "{query}".')
            return
        if status == "typo":
            await channel.send(f'Did you misspell "{data}"?')
            return

        rares = [e for e in data if e["display"] in RARE]
        if not rares:
            await channel.send("Only secrets, eternal and divine eggs have values.")
            return
        if len(rares) > 1:
            await channel.send(self._ambiguous_text(query, rares).replace("!alert_", "!value_"))
            return

        egg = rares[0]
        tier, value, image = RARE[egg["display"]]
        color, tier_emoji = TIER_STYLE[tier]
        embed = discord.Embed(title=f"{tier_emoji}  {egg['display']} Egg  {tier_emoji}", colour=color)
        embed.add_field(name="🥚 Egg", value=f"**{egg['display']} Egg**", inline=True)
        embed.add_field(name="💎 Rarity", value=f"**{tier}**", inline=True)
        embed.add_field(name="🕒 Last Seen", value=self._seen_text(guild.id, egg), inline=True)
        embed.add_field(name="💰 EGG VALUE", value=f"```{value}```", inline=False)
        if image:
            embed.set_thumbnail(url=image)
        await channel.send(embed=embed)

