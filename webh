            "full": _display.lower(),
        })
EGG_BY_DISPLAY = {e["display"]: e for e in EGGS}

# text the bot can suggest: first names and full names -> how to show them
LABELS = {}
for _e in EGGS:
    LABELS.setdefault(_e["first"], _e["display"].split()[0])
    LABELS[_e["full"]] = _e["display"]


def find_eggs(query):
    """Returns ("ok", [egg, ...]) | ("typo", "Suggested label") | ("none", None)"""
    q = re.sub(r"[\s_]+", " ", query or "").strip().lower()
    qn = norm(q)
    if not qn:
        return "none", None

    exact = [e for e in EGGS if qn in e["keys"]]          # full name (or alias) wins
    if exact:
        return "ok", exact

    first = [e for e in EGGS if e["first"] == q]          # the egg's first name
    if first:
        return "ok", first

    close = difflib.get_close_matches(q, list(LABELS), n=1, cutoff=TYPO_CUTOFF)
    if close:
        return "typo", LABELS[close[0]]
    return "none", None


def parse_duration(text):
    if not text:
        return None
    parts = re.findall(r"(\d+)\s*([dhms])", str(text).lower())
    if not parts:
        return None
    mult = {"d": 86400, "h": 3600, "m": 60, "s": 1}
    return sum(int(n) * mult[u] for n, u in parts)


def fmt_elapsed(seconds):
    """12d, 1s  -  zero units are skipped"""
    seconds = int(max(0, seconds))
    d, r = divmod(seconds, 86400)
    h, r = divmod(r, 3600)
    m, s = divmod(r, 60)
    parts = []
    if d: parts.append(f"{d}d")
    if h: parts.append(f"{h}h")
    if m: parts.append(f"{m}m")
    if s or not parts: parts.append(f"{s}s")
    return ", ".join(parts)


def _as_of_ts(text):
    return datetime.strptime(text, "%Y-%m-%d %H:%M").replace(
        tzinfo=timezone(timedelta(hours=LAST_SEEN_TZ_HOURS))).timestamp()


