class LastSeenView(discord.ui.View):
    def __init__(self, cog, guild_id, owner_id):
        super().__init__(timeout=300)
        self.cog = cog
        self.guild_id = guild_id
        self.owner_id = owner_id
        self.tier = "Divine"
        self.message = None
        self._style_buttons()

    async def interaction_check(self, interaction):
        if interaction.user.id != self.owner_id:
            await interaction.response.send_message("This box isn't yours. Run `!ls` yourself.",
                                                    ephemeral=True)
            return False
        return True

    async def on_timeout(self):
        for child in self.children:
            child.disabled = True
        if self.message:
            try:
                await self.message.edit(view=self)
            except discord.HTTPException:
                pass

    def _style_buttons(self):
        for child in self.children:
            child.style = (discord.ButtonStyle.primary if child.label == self.tier
                           else discord.ButtonStyle.secondary)

    def build_embed(self):
        color, tier_emoji = TIER_STYLE[self.tier]

        # The Last Seen tracker can include rare eggs that are not yet in RARE.
        # These three are Secret eggs and already exist in CATALOG / EGG_EMOJIS.
        secret_extra = ["King Snake", "Ice Dragon", "Stag"]
        names = [d for d, v in RARE.items() if v[0] == self.tier]
        if self.tier == "Secret":
            for display in secret_extra:
                if display not in names:
                    names.append(display)

        # Eggs with no value entry are placed after the valued eggs.
        names.sort(key=lambda d: parse_money(RARE.get(d, (None, "0M/s", None))[1]) or 0,
                   reverse=True)
        live = self.cog._live_set(self.guild_id) or set()

        lines = []
        for display in names:
            egg = EGG_BY_DISPLAY.get(display)
            emoji = self.cog._emoji(egg) if egg else "🥚"
            if display in live:
                seen = "🟢 **Available now**"
            else:
                ts = self.cog._last_seen_ts(self.guild_id, display)
                seen = f"<t:{int(ts)}:R>" if ts is not None else "No data yet"
            lines.append(f"{emoji} **{display}**  —  {seen}")

        embed = discord.Embed(title=f"{tier_emoji}  {self.tier} eggs", colour=color,
                              description="\n".join(lines) or "*No eggs in this tier.*")
        embed.set_author(name="Last Seen Tracker")
        embed.set_footer(text=f"{len(names)} eggs  •  highest value first")
        return embed

    async def switch(self, interaction, tier):
        self.tier = tier
        self._style_buttons()
        await interaction.response.edit_message(embed=self.build_embed(), view=self)

    @discord.ui.button(label="Divine", emoji="✨")
    async def divine(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.switch(interaction, "Divine")

    @discord.ui.button(label="Eternal", emoji="♾️")
    async def eternal(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.switch(interaction, "Eternal")

    @discord.ui.button(label="Secret", emoji="🔮")
    async def secret(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.switch(interaction, "Secret")


class EggAlerts(commands.Cog):
    def __init__(self, bot):
        self.bot = bot
        self.db = sqlite3.connect(DB_PATH)
        self.db.execute(
            """CREATE TABLE IF NOT EXISTS egg_alerts (
                   guild_id INTEGER, user_id INTEGER, egg TEXT, created_at REAL,
                   PRIMARY KEY (guild_id, user_id, egg))""")
        self.db.execute(
            """CREATE TABLE IF NOT EXISTS egg_last_seen (
                   guild_id INTEGER, egg TEXT, seen_at REAL,
                   PRIMARY KEY (guild_id, egg))""")
        self.db.commit()
        self._prev = {}   # guild_id -> set of egg display names that were live in the previous feed

    async def cog_unload(self):
        self.db.close()

    # ---------- small helpers ----------
    def _egg_cog(self):
        return self.bot.get_cog("EggStatus")

    def _row(self, guild_id):
        cog = self._egg_cog()
        return cog._get(guild_id) if cog else None

    def _board_channel(self, guild_id):
        row = self._row(guild_id)
        if not row or not row["board_channel_id"]:
            return None
        return self.bot.get_channel(row["board_channel_id"])

    @staticmethod
    def _live_from(counts):
        return {e["display"] for e in EGGS if any(counts.get(k, 0) > 0 for k in e["keys"])}

    def _live_set(self, guild_id):
        """Eggs live right now, or None if the feed is offline / has no data."""
        row = self._row(guild_id)
        if not row or not row["counts"] or not row["updated_at"]:
            return None
        if time.time() - row["updated_at"] > OFFLINE_AFTER:
            return None
        return self._live_from(json.loads(row["counts"]))

    def _emoji(self, egg):
        try:
            cog = self._egg_cog()
            by_name, by_norm = cog._emoji_maps()
            return cog._emoji_for(egg["display"], egg["keys"], by_name, by_norm)[0]
        except Exception:
            return "🥚"

    def _last_seen_ts(self, guild_id, display):
        vals = []
        if display in HARD_TS:
            vals.append(HARD_TS[display])
        r = self.db.execute("SELECT seen_at FROM egg_last_seen WHERE guild_id = ? AND egg = ?",
                            (guild_id, display)).fetchone()
        if r:
            vals.append(r[0])
        return max(vals) if vals else None

    def _seen_text(self, guild_id, egg):
        live = self._live_set(guild_id)
        if live and egg["display"] in live:
            return "🟢 **Available now**"
        ts = self._last_seen_ts(guild_id, egg["display"])
        if ts is None:
            return "No data yet"
        # <t:..:R> keeps counting up on its own in Discord; the code text is the exact time when sent
        return f"**<t:{int(ts)}:R>**\n`{fmt_elapsed(time.time() - ts)}`"

    @staticmethod
    def _ambiguous_text(query, eggs):
        names = ", ".join(f"**{e['display']}**" for e in eggs)
        example = eggs[0]["display"].replace(" ", "_")
        return (f'More than one egg matches "{query}": {names}.\n'
                f"Use the full name, e.g. `!alert_{example}`")

    # ---------- feed hook (called from EggStatus.on_message) ----------
    async def on_feed(self, guild_id, counts):
        live = self._live_from(counts)
        prev = self._prev.get(guild_id)
        self._prev[guild_id] = live

        now = time.time()
        # Record the time an egg FIRST appears in a cycle, not every feed tick.
        # On startup, currently-live eggs become the new baseline and reset to now.
        appeared = live if prev is None else (live - prev)
        if appeared:
            self.db.executemany("INSERT OR REPLACE INTO egg_last_seen (guild_id, egg, seen_at) VALUES (?, ?, ?)",
                                [(guild_id, d, now) for d in appeared])
            self.db.commit()

        if prev is None:      # first data since the bot started = baseline, don't ping
            return
        channel = self._board_channel(guild_id)
        if channel is None:
            return

        for display in live - prev:   # eggs that just appeared
            rows = self.db.execute("SELECT user_id FROM egg_alerts WHERE guild_id = ? AND egg = ?",
                                   (guild_id, display)).fetchall()
            if not rows:
                continue
            mentions = " ".join(f"<@{r[0]}>" for r in rows)
            emoji = self._emoji(EGG_BY_DISPLAY[display])
            try:
                await channel.send(f"🔔 {mentions} - {emoji} **{display}** is available now!",
                                   delete_after=PING_LIFETIME,
                                   allowed_mentions=discord.AllowedMentions(users=True))
            except discord.HTTPException as e:
                print(f"[EGG] alert ping failed: {e}")
                continue
            self.db.execute("DELETE FROM egg_alerts WHERE guild_id = ? AND egg = ?", (guild_id, display))
            self.db.commit()

    # ---------- command logic (shared by !alert x and !alert_x) ----------
    async def _handle_alert(self, channel, guild, author, query):
        if not query:
            await channel.send("Usage: `!alert_penguin`")
            return
        status, data = find_eggs(query)
        if status == "none":
            await channel.send(f'I couldn\'t find an egg called "{query}". alert not created.')
            return
        if status == "typo":
            await channel.send(f'Did you misspell "{data}"? alert not created.')
            return
        if len(data) > 1:
            await channel.send(self._ambiguous_text(query, data) + "\nalert not created.")
            return

        egg = data[0]
        display = egg["display"]
        cur = self.db.execute(
            "INSERT OR IGNORE INTO egg_alerts (guild_id, user_id, egg, created_at) VALUES (?, ?, ?, ?)",
            (guild.id, author.id, display, time.time()))
        self.db.commit()
        if cur.rowcount == 0:
            await channel.send(f"{author.mention} you already have an alert for **{display}**.")
            return

        board = self._board_channel(guild.id)
        where = board.mention if board else "the egg board channel"
        msg = f"🔔 Rest assured {author.mention}, I will ping you when **{display}** is available in {where}"
        if display in (self._live_set(guild.id) or set()):
            msg += "\n*(It's live right now, so I'll ping you the next time it shows up.)*"
        await channel.send(msg)

    async def _handle_value(self, channel, guild, query):
        if not query:
            await channel.send("Usage: `!value_kraken`")
            return
        status, data = find_eggs(query)
        if status == "none":
            await channel.send(f'I couldn\'t find an egg called "{query}".')
            return
        if status == "typo":
            await channel.send(f'Did you misspell "{data}"?')
            return

        rares = [e for e in data if e["display"] in RARE]
        if not rares:
            await channel.send("Only secrets, eternal and divine eggs have values.")
            return
        if len(rares) > 1:
            await channel.send(self._ambiguous_text(query, rares).replace("!alert_", "!value_"))
            return

        egg = rares[0]
        tier, value, image = RARE[egg["display"]]
        color, tier_emoji = TIER_STYLE[tier]
        embed = discord.Embed(title=f"{tier_emoji}  {egg['display']} Egg  {tier_emoji}", colour=color)
        embed.add_field(name="🥚 Egg", value=f"**{egg['display']} Egg**", inline=True)
        embed.add_field(name="💎 Rarity", value=f"**{tier}**", inline=True)
        embed.add_field(name="🕒 Last Seen", value=self._seen_text(guild.id, egg), inline=True)
        embed.add_field(name="💰 EGG VALUE", value=f"```{value}```", inline=False)
        if image:
            embed.set_thumbnail(url=image)
        await channel.send(embed=embed)

    # ---------- commands: "!alert penguin" ----------
    async def _configured(self, ctx):
        if self._row(ctx.guild.id) is None or self._board_channel(ctx.guild.id) is None:
            await ctx.send("The egg board isn't set up in this server yet (an admin needs to run `!eggdisplay`).")
            return False
        return True

    @commands.command(name="alert")
    @commands.guild_only()
    async def alert(self, ctx, *, egg: str = ""):
        """!alert penguin - ping me when the egg is available"""
        if await self._configured(ctx):
            await self._handle_alert(ctx.channel, ctx.guild, ctx.author, egg)

    @commands.command(name="value", aliases=["val", "v"])
    @commands.guild_only()
    async def value(self, ctx, *, egg: str = ""):
        """!value kraken - value of a Secret / Eternal / Divine egg"""
        if await self._configured(ctx):
            await self._handle_value(ctx.channel, ctx.guild, egg)

    @commands.command(name="mutate", aliases=["calc", "mutation"])
    @commands.guild_only()
    async def mutate(self, ctx):
        """!mutate - interactive Money/s calculator"""
        view = MutateView(ctx.author.id)
        view.message = await ctx.send(embed=view.build_embed(), view=view)

    @commands.command(name="ls", aliases=["last_seen", "lastseen", "last"])
    @commands.guild_only()
    async def ls(self, ctx):
        """!ls - last seen times for Divine / Eternal / Secret eggs"""
        view = LastSeenView(self, ctx.guild.id, ctx.author.id)
        view.message = await ctx.send(embed=view.build_embed(), view=view)

    # ---------- "!alert_penguin" style ----------
    @commands.Cog.listener()
    async def on_message(self, message):
        if message.author.bot or not message.guild:
            return
        prefix = self.bot.command_prefix
        if not isinstance(prefix, str) or not message.content.startswith(prefix):
            return
        m = UNDERSCORE_RE.match(message.content[len(prefix):].strip())
        if not m:
            return
        if self._row(message.guild.id) is None or self._board_channel(message.guild.id) is None:
            return  # only servers where !eggdisplay was run

        cmd, arg = m.group(1).lower(), m.group(2)
        if cmd == "alert":
            await self._handle_alert(message.channel, message.guild, message.author, arg)
        elif cmd == "value":
            await self._handle_value(message.channel, message.guild, arg)



