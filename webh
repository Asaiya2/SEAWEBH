local EGG_LOOKUP = {}
for _, name in ipairs(SECRETS)  do EGG_LOOKUP[name:lower()] = "Secret"  end
for _, name in ipairs(ETERNALS) do EGG_LOOKUP[name:lower()] = "Eternal" end
for _, name in ipairs(DIVINES)  do EGG_LOOKUP[name:lower()] = "Divine"  end

local httpRequest = request or http_request or (syn and syn.request)

-- Game name (falls back to game.Name if the lookup is blocked)
local GAME_NAME = game.Name
task.spawn(function()
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId)
    end)
    if ok and info and info.Name then
        GAME_NAME = info.Name
    end
end)

local function stripTags(text)
    return (text:gsub("<[^>]->", ""))
end

local function prettyName(name)
    return (name:gsub("(%a)([%w']*)", function(a, b)
        return a:upper() .. b:lower()
    end))
end

local function sendPayload(payload)
    if not httpRequest then
        warn("[WORST NOTIFIER] No HTTP request function found in this executor.")
        return
    end
    pcall(function()
        httpRequest({
            Url     = WEBHOOK_URL,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = HttpService:JSONEncode(payload),
        })
    end)
end

-- Parse: "A Eternal Gorilla King Egg spawned in Titan Temple"
-- Returns: eggName, tier
local function parseEggMessage(clean)
    local rarity, eggName = clean:match("[Aa]n?%s+(%a+)%s+(.-)%s+spawned%s+in")
    if not rarity or not eggName then return nil end

    rarity = rarity:lower()
    if rarity ~= "secret" and rarity ~= "eternal" and rarity ~= "divine" then
        return nil
    end

    eggName = eggName:lower():gsub("%s+$", "")
    eggName = eggName:gsub("%s+egg$", "")

    local tier = EGG_LOOKUP[eggName]
    if not tier then return nil end

    return eggName, tier
end

local function sendEggEmbed(eggName, tier)
    local style   = STYLE[tier]
    local roleId  = ROLE_IDS[tier]
    local mention = roleId and ("<@&" .. roleId .. ">") or ""
    local name    = prettyName(eggName) .. " Egg"
    local now     = os.time()

    sendPayload({
        username         = BOT_NAME,
        avatar_url       = (BOT_AVATAR ~= "") and BOT_AVATAR or nil,
        content          = mention .. " " .. style.emoji .. " **" .. name .. "** just spawned!",
        allowed_mentions = { parse = { "roles" } },
        embeds = {{
            title       = style.emoji .. "  " .. style.title .. "  " .. style.emoji,
            description = "*" .. style.tag .. "*",
            color       = style.color,
            fields = {
                { name = "🥚 Egg",    value = "**" .. name .. "**", inline = true },
                { name = "💎 Rarity", value = "**" .. tier .. "**", inline = true },
                -- Discord's built-in relative timestamp: counts up on its own
                { name = "⏱️ Time Lapsed", value = "**<t:" .. now .. ":R>**", inline = true },
                { name = "🎮 GAME NAME", value = "```" .. GAME_NAME .. "```", inline = false },
            },
            footer    = { text = "https://discord.gg/hTNwM78Qg2 • " .. tier .. " Alert" },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", now),
        }},
    })
end

-- ============================================================
--  DEDUPE - same egg is ignored during the cooldown
-- ============================================================
local lastSeen = {}

-- ============================================================
--  MAIN LISTENER
-- ============================================================
TextChatService.MessageReceived:Connect(function(msg)
    if msg.TextSource then return end -- ignore player messages entirely

    local clean = stripTags(msg.Text)

    local eggName, tier = parseEggMessage(clean)
    if not eggName then return end

    local last = lastSeen[eggName]
    if last and os.clock() - last < COOLDOWN then return end
    lastSeen[eggName] = os.clock()

    sendEggEmbed(eggName, tier)
end)

