    def __init__(self, bot):
        self.bot = bot
        os.makedirs(DB_FOLDER, exist_ok=True)
        self.db = sqlite3.connect(DB_PATH)
        self.db.row_factory = sqlite3.Row

        # per-server data: where this server's boards live
        self.db.execute(
            """CREATE TABLE IF NOT EXISTS egg_board (
                   guild_id         INTEGER PRIMARY KEY,
                   input_channel_id INTEGER,
                   board_channel_id INTEGER,
                   board_message_id INTEGER,
                   last_seen_message_id INTEGER,
                   counts           TEXT,
                   updated_at       REAL)"""
        )
        # upgrade older databases
        cols = {r[1] for r in self.db.execute("PRAGMA table_info(egg_board)")}
        if "board_message_ids" not in cols:  # the board message ids, as a JSON list
            self.db.execute("ALTER TABLE egg_board ADD COLUMN board_message_ids TEXT")
        if "cycle_end" not in cols:          # (old) unix time of the next egg reroll
            self.db.execute("ALTER TABLE egg_board ADD COLUMN cycle_end REAL")
        if "last_seen_message_id" not in cols:
            self.db.execute("ALTER TABLE egg_board ADD COLUMN last_seen_message_id INTEGER")
        if "scramble" not in cols:           # (old) current Dr. Scramble banner name
            self.db.execute("ALTER TABLE egg_board ADD COLUMN scramble TEXT")
        if "scramble_end" not in cols:       # (old) unix time the banner rotates
            self.db.execute("ALTER TABLE egg_board ADD COLUMN scramble_end REAL")

        # global data: the ONE feed (single row, id = 1) shared by every server
        self.db.execute(
            """CREATE TABLE IF NOT EXISTS egg_feed (
                   id               INTEGER PRIMARY KEY,
                   input_guild_id   INTEGER,
                   input_channel_id INTEGER,
                   counts           TEXT,
                   updated_at       REAL,
                   cycle_end        REAL,
                   scramble         TEXT,
                   scramble_end     REAL)"""
        )
        if self.db.execute("SELECT 1 FROM egg_feed WHERE id = 1").fetchone() is None:
            # first run of the multi-server version: carry the old single-server feed over
            old = self.db.execute(
                """SELECT guild_id, input_channel_id, counts, updated_at, cycle_end, scramble, scramble_end
                   FROM egg_board WHERE input_channel_id IS NOT NULL
                   ORDER BY updated_at DESC LIMIT 1""").fetchone()
            if old:
                self.db.execute(
                    """INSERT INTO egg_feed (id, input_guild_id, input_channel_id, counts, updated_at,
                                             cycle_end, scramble, scramble_end)
                       VALUES (1, ?, ?, ?, ?, ?, ?, ?)""", tuple(old))
            else:
                self.db.execute("INSERT INTO egg_feed (id) VALUES (1)")
        self.db.commit()

        self._locks = defaultdict(asyncio.Lock)  # one edit/post pass at a time per server
        self._offline = {}                       # guild_id -> last known offline state
        self._expired = {}                       # guild_id -> last known "countdown reached 0" state
        self._unknown = {}                       # egg names in the latest feed that the catalog doesn't know -> count
        self._last = {}                          # (guild_id, board index) -> last embed sent, to skip useless edits

    async def cog_load(self):
        self.watchdog.start()

    async def cog_unload(self):
        self.watchdog.cancel()
        self.db.close()

    # ---------- storage ----------
    def _feed(self):
        """The shared feed state (counts, timers, banner) as a dict. Same for every server."""
        r = self.db.execute("SELECT * FROM egg_feed WHERE id = 1").fetchone()
        return dict(r) if r else {}

    def _save_feed(self, **fields):
        sets = ", ".join(f"{k} = ?" for k in fields)  # keys come from this file only
        self.db.execute(f"UPDATE egg_feed SET {sets} WHERE id = 1", tuple(fields.values()))
        self.db.commit()

    def _get(self, guild_id):
        """This server's board row, merged with the shared feed. None if the server has no row yet."""
        r = self.db.execute("SELECT * FROM egg_board WHERE guild_id = ?", (guild_id,)).fetchone()
        if r is None:
            return None
        row = dict(r)
        feed = self._feed()
        for k in FEED_FIELDS:
            row[k] = feed.get(k)
        return row

    def _save(self, guild_id, **fields):
        self.db.execute("INSERT OR IGNORE INTO egg_board (guild_id) VALUES (?)", (guild_id,))
        sets = ", ".join(f"{k} = ?" for k in fields)  # keys come from this file only
        self.db.execute(f"UPDATE egg_board SET {sets} WHERE guild_id = ?", (*fields.values(), guild_id))
        self.db.commit()

    def _board_guild_ids(self):
        """Every server that has boards posted."""
        rows = self.db.execute(
            "SELECT guild_id FROM egg_board WHERE board_message_ids IS NOT NULL AND board_channel_id IS NOT NULL"
        ).fetchall()
        return [r["guild_id"] for r in rows]

    @staticmethod
    def _ids(row):
        if not row or not row["board_message_ids"]:
            return []
        try:
            return [int(x) for x in json.loads(row["board_message_ids"])]
        except (ValueError, TypeError):
            return []

    def _last_seen_id(self, row):
        if not row or not row["last_seen_message_id"]:
            return None
        try:
            return int(row["last_seen_message_id"])
        except (ValueError, TypeError):
            return None

    # ---------- emoji ----------
    def _emoji_maps(self):
        available = [e for e in self.bot.emojis if e.available]
        by_name = {e.name.lower(): str(e) for e in available}   # exact name, e.g. "chicken_w"
        by_norm = {norm(e.name): str(e) for e in available}     # loose name, e.g. "chicken"
        return by_name, by_norm

    def _emoji_for(self, display, keys, by_name, by_norm):
        """Returns (emoji, found). found=False means the egg is still using the default."""
        raw = (EGG_EMOJIS.get(display) or "").strip()
        if raw and raw.lower() != PLACEHOLDER:
            m = re.fullmatch(r":([A-Za-z0-9_]+):", raw)
            if m:  # ":Chicken_W:" -> look the emoji up by name
                hit = by_name.get(m.group(1).lower())
                if hit:
                    return hit, True
            else:  # "<:Chicken_W:123>" or a unicode emoji -> use as is
                return raw, True
        # fallback: an emoji simply named like the egg (e.g. "dog")
        auto = next((by_norm[k] for k in keys if k in by_norm), None)
        return (auto, True) if auto else (DEFAULT_EMOJI, False)

    # ---------- Last Seen helpers ----------
    def _last_seen_value(self, guild_id, display):
        """Return a Discord relative timestamp for the egg's last appearance."""
        alerts = self.bot.get_cog("EggAlerts")
        if not alerts:
            return "—"
        try:
            ts = alerts._last_seen_ts(guild_id, display)
        except Exception:
            return "—"
        return f"<t:{int(ts)}:R>" if ts is not None else "—"

    # ---------- rendering ----------
    def _board_live_stats(self, counts, zones):
        total_types = sum(len(CATALOG[z]) for z in zones)
        live_types = 0
        total_eggs = 0
        for zone in zones:
            for _, keys in CATALOG[zone]:
                n = sum(counts.get(k, 0) for k in keys)
                if zone != "Dr Scramble":   # the banner is not a field egg
                    total_eggs += n
                if n > 0:
                    live_types += 1
        return total_types, live_types, total_eggs

    def _rarest_live(self, counts, zones):
        tier_rank = {"Secret": 1, "Eternal": 2, "Divine": 3}
        best = None
        best_rank = 0
        for zone in zones:
            for display, keys in CATALOG[zone]:
                if sum(counts.get(k, 0) for k in keys) <= 0:
                    continue
                info = RARE.get(display)
                if not info:
                    continue
                tier = info[0]
                rank = tier_rank.get(tier, 0)
                if rank > best_rank:
                    best = (display, tier)
                    best_rank = rank
        return best

    def _render_board(self, guild_id, idx, counts, updated_at, offline, cycle_end, maps, scramble=None):
        by_name, by_norm = maps
        zones = BOARDS[idx]
        key = board_key(zones)
        down = updated_at is None or offline
        color = GREY if down else BOARD_COLORS.get(key, DEFAULT_COLOR)
        embed = discord.Embed(colour=color)

        zone_title = "  /  ".join(
            f"{ZONE_ICONS.get(z, '')} {z}" for z in zones
        )
        total_types, live_types, total_eggs = self._board_live_stats(counts, zones)
        embed.title = zone_title

        # Dr Scramble has no field eggs, so it doesn't show an egg count.
        eggs_line = "" if "Dr Scramble" in zones else f"\n🥚 **{total_eggs} eggs**"

        if down:
            status = "⚠️ **Feed offline** — showing last known data" if updated_at else "⏳ **Waiting for egg data…**"
            embed.description = f"{status}{eggs_line}"
        elif cycle_end:
            remaining = max(0.0, cycle_end - time.time())

            if remaining >= 60:
                minutes = int(remaining // 60)
                seconds = int(remaining % 60)
                if seconds:
                    time_text = f"{minutes}m {seconds}s"
                else:
                    time_text = f"{minutes}m"
            else:
                time_text = f"{int(remaining)}s"

            embed.description = f"⏱️ **Will Auto Update when Available eggs Update**"
        else:
            embed.description = f"⏱️ **Next update: calibrating…**{eggs_line}"

        if "Dr Scramble" in zones:
            # The egg reroll timer doesn't apply here. "Next update" is the time
            # left until the Dr Scramble banner rotates.
            name, end = scramble if scramble else (None, None)
            parts = []
            if down:
                parts.append("⚠️ **Feed offline** — showing last known data" if updated_at
                             else "⏳ **Waiting for egg data…**")
            elif end:
                left = end - time.time()
                if left > 0:
                    parts.append(f"**The Board will update when the banner changes**")
                else:
                    parts.append("⏱️ **Next update: any moment…**")
            if name:
                parts.append(f"🧪 **Current banner:** {name}")
            embed.description = "\n".join(parts) or "⏳ **Waiting for banner data…**"

        thumb = BOARD_THUMBNAILS.get(key)
        if thumb:
            embed.set_thumbnail(url=thumb)

        # A board with a single biome uses the full width; two biomes sit side by side.
        side_by_side = len(zones) > 1

        def zone_field(zone):
            lines = []
            live = 0
            # Always use the fixed catalog order. Availability never changes
            # an egg's position on the board.
            for display, keys in CATALOG[zone]:
                n = sum(counts.get(k, 0) for k in keys)
                emoji, _ = self._emoji_for(display, keys, by_name, by_norm)
                seen = self._last_seen_value(guild_id, display)
                rarity = RARE.get(display)
                tag = f" **`{rarity[0].upper()}`**" if rarity else ""
                if n > 0:
                    live += 1
                    lines.append(f"🟢 {emoji} **{display}** **{n}**{tag}  {seen}")
                else:
                    lines.append(f"🔴 {emoji} {display} 0{tag}  {seen}")
            name = f"{zone}  ·  {live}/{len(CATALOG[zone])}"
            embed.add_field(name=name, value="\n".join(lines), inline=side_by_side)

        if len(zones) == 3:
            # 3-zone layout: first row = zone 1 | empty | zone 2; second row = empty | zone 3 | empty.
            zone_field(zones[0])
            embed.add_field(name="\u200b", value="\u200b", inline=True)
            zone_field(zones[1])
            embed.add_field(name="\u200b", value="\u200b", inline=True)
            zone_field(zones[2])
            embed.add_field(name="\u200b", value="\u200b", inline=True)
        else:
            for zone in zones:
                zone_field(zone)

        rarest = self._rarest_live(counts, zones)
        if rarest:
            embed.set_footer(text=f"🏆 Rarest egg: {rarest[0]}")
        else:
            embed.set_footer(text="https://discord.gg/W0RST  •  WORST NOTIFIER")

        return embed

    def _embeds(self, row):
        counts = json.loads(row["counts"]) if row and row["counts"] else {}
        updated = row["updated_at"] if row else None
        cycle_end = row["cycle_end"] if row else None
        offline = updated is None or time.time() - updated > OFFLINE_AFTER
        maps = self._emoji_maps()
        scramble = (row["scramble"], row["scramble_end"]) if row and row["scramble"] else None

        out = []
        for i, zones in enumerate(BOARDS):
            key = board_key(zones)
            # First embed = banner image; second embed = actual board. Both share
            # the same colour and are sent as ONE Discord message.
            banner_url = BANNERS.get(key, DEFAULT_BANNER)
            board = self._render_board(row["guild_id"], i, counts, updated, offline, cycle_end, maps, scramble)
            if banner_url:
                banner = discord.Embed(colour=GREY if offline else BOARD_COLORS.get(key, DEFAULT_COLOR))
                banner.set_image(url=banner_url)
                out.append([banner, board])
            else:
                out.append([board])
        return out

    # ---------- posting / editing without ever spamming ----------
    def _is_board_message(self, msg):
        """True for any egg board message this bot posted (this version or an older one)."""
        if msg.author.id != self.bot.user.id or not msg.embeds:
            return False
        zones = list(CATALOG)
        for e in msg.embeds:
            if e.title and "Available Eggs" in e.title:
                return True
            if any(z in (f.name or "") for f in e.fields for z in zones):
                return True
        return False

    async def _post_boards(self, channel):
        """Wipes every old board message, then posts all the board messages.
        Each board message contains a banner embed followed by the board embed.
        The caller must already hold self._locks[guild_id]."""
        gid = channel.guild.id
        # make sure this server has a row first (a brand new server has none yet)
        self._save(gid, board_channel_id=channel.id)
        try:
            # limit is high enough to also catch the older 7-board layout
            async for msg in channel.history(limit=200):
                if self._is_board_message(msg):
                    try:
                        await msg.delete()
                    except discord.HTTPException:
                        pass
        except discord.HTTPException as e:
            print(f"[EGG] could not clean old boards (need Read Message History?): {e}")

        embed_groups = self._embeds(self._get(gid))
        ids = []
        for embeds in embed_groups:
            msg = await channel.send(embeds=embeds)
            ids.append(msg.id)

        self._save(gid, board_channel_id=channel.id,
                   board_message_ids=json.dumps(ids),
                   board_message_id=None)
        self._last = {k: v for k, v in self._last.items() if k[0] != gid}
        for i, embeds in enumerate(embed_groups):
            self._last[(gid, i)] = [e.to_dict() for e in embeds]

    async def _refresh(self, guild_id):
        async with self._locks[guild_id]:
            row = self._get(guild_id)
            ids = self._ids(row)
            if not row or not row["board_channel_id"]:
                return

            channel = self.bot.get_channel(row["board_channel_id"])
            if channel is None:
                # channel not in cache (lag / reconnect). Do NOT post new messages.
                print(f"[EGG] board channel {row['board_channel_id']} not available, skipping")
                return

            # Migrate older versions: remove the separate Last Seen message.
            old_last_seen_id = self._last_seen_id(row)
            if old_last_seen_id:
                try:
                    await channel.get_partial_message(old_last_seen_id).delete()
                except (discord.NotFound, discord.HTTPException):
                    pass
                self._save(guild_id, last_seen_message_id=None)
                row = self._get(guild_id)

            # One message per board in BOARDS. Last Seen is rendered inside each board.
            # If the number of saved messages doesn't match (for example after
            # adding/removing boards), wipe and rebuild all of them.
            if len(ids) != len(BOARDS):
                try:
                    await self._post_boards(channel)
                except discord.HTTPException as e:
                    print(f"[EGG] could not rebuild boards: {e}")
                return

            embed_groups = self._embeds(row)
            for i, embeds in enumerate(embed_groups):
                snap = [e.to_dict() for e in embeds]
                if self._last.get((guild_id, i)) == snap:
                    continue  # this board didn't change, don't touch it
                try:
                    await channel.get_partial_message(ids[i]).edit(embeds=embeds)
                    self._last[(guild_id, i)] = snap
                except discord.NotFound:
                    # a board message is gone -> rebuild all boards in order instead of adding one at the bottom
                    print(f"[EGG] board {i + 1} was deleted, reposting all boards")
                    try:
                        await self._post_boards(channel)
                    except discord.HTTPException as e:
                        print(f"[EGG] could not repost boards: {e}")
                    return
                except discord.HTTPException as e:
                    # rate limit / Discord hiccup / missing permission: retry on the next update
                    print(f"[EGG] board {i + 1} edit failed, will retry: {e}")

    async def _refresh_all(self):
        """Refresh the boards of every server at the same time."""
        ids = self._board_guild_ids()
        if not ids:
            return
        results = await asyncio.gather(*(self._refresh(g) for g in ids), return_exceptions=True)
        for gid, res in zip(ids, results):
            if isinstance(res, Exception):
                print(f"[EGG] refresh failed for server {gid}: {res}")

    # ---------- receiving data from Roblox ----------
    @commands.Cog.listener()
    async def on_message(self, message):
        if not message.guild or message.webhook_id is None:
            return
        if not message.content.startswith(FEED_PREFIX):
            return
        feed = self._feed()
        if not feed.get("input_channel_id") or feed["input_channel_id"] != message.channel.id:
            return

        try:
            data = json.loads(message.content[len(FEED_PREFIX):])
        except ValueError:
            return
        if not isinstance(data, dict):  # Roblox encodes an empty table as []
            data = {}

        age = data.pop("_age", None)  # seconds since the current egg cycle started (not an egg)
        scramble = data.pop("_scramble", None)  # current Dr. Scramble banner name (not an egg)
        data.pop("_scramble_left", None)        # ignored: the bot runs its own 1 hour countdown
        now = time.time()
        counts = {norm(k): int(v) for k, v in data.items() if isinstance(v, (int, float))}
        if isinstance(scramble, str) and scramble.strip():
            sk = norm(scramble)
            for _, keys in CATALOG["Dr Scramble"]:
                if sk in keys:
                    counts[keys[0]] = 1   # the active banner counts as "available"
        self._unknown = {k: v for k, v in counts.items() if k not in ALL_KEYS}

        fields = {"counts": json.dumps(counts), "updated_at": now}
        if isinstance(age, (int, float)) and age >= 0:
            new_end = now - age + REROLL_INTERVAL
            old_end = feed.get("cycle_end")
            # only move the timer when it really changed (a new cycle), so tiny
            # delays don't cause an edit on every message
            if old_end is None or abs(new_end - old_end) > DRIFT_TOLERANCE:
                fields["cycle_end"] = new_end

        if isinstance(scramble, str) and scramble.strip():
            new_name = scramble.strip()[:40]
            fields["scramble"] = new_name
            # banner changed (or first time seen) -> start a fresh 1 hour countdown
            if feed.get("scramble") != new_name or feed.get("scramble_end") is None:
                fields["scramble_end"] = now + SCRAMBLE_INTERVAL
        self._save_feed(**fields)

        # Keep the Last Seen tracker synchronized with the same feed that
        # drives the available-egg boards. This also powers user egg alerts
        # and the Secret / Eternal / Divine pings in every server.
        alerts = self.bot.get_cog("EggAlerts")
        if alerts is not None:
            try:
                await alerts.on_feed(counts)
            except Exception as e:
                print(f"[EGG] Last Seen/alert feed update failed: {e}")

        for gid in self._board_guild_ids():
            self._offline[gid] = False
            self._expired.pop(gid, None)

        try:  # keep the feed channel clean (needs Manage Messages there)
            await message.delete()
        except discord.HTTPException:
            pass

        await self._refresh_all()

    @tasks.loop(seconds=5)
    async def watchdog(self):
        """Refresh the boards every 5 seconds so the reroll countdown bar moves."""
        try:
            feed = self._feed()
            now = time.time()
            updated = feed.get("updated_at")
            cycle_end = feed.get("cycle_end")
            offline = updated is None or now - updated > OFFLINE_AFTER
            expired = cycle_end is not None and now > cycle_end
            for gid in self._board_guild_ids():
                self._offline[gid] = offline
                self._expired[gid] = expired
            await self._refresh_all()
        except Exception as e:
            print(f"[EGG] watchdog error: {e}")

    @watchdog.before_loop
    async def _before_watchdog(self):
        await self.bot.wait_until_ready()

