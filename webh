    # ---------- rare egg notification setup ----------
    # !secret #channel | !secret ping @role | !secret | !secret off | !secret ping off
    # (same for !eternal and !divine). Administrator only.
    #
    # Note: a group with invoke_without_command=True does NOT run its own checks before a
    # subcommand, so every subcommand carries the same checks as the group.
    async def _tier_show(self, ctx, tier):
        color, tier_emoji = TIER_STYLE[tier]
        cfg = self._get_cfg(ctx.guild.id, tier)
        ch = self.bot.get_channel(cfg["channel_id"]) if cfg["channel_id"] else None
        board = self._board_channel(ctx.guild.id)
        if ch:
            ch_text = ch.mention
        elif board:
            ch_text = f"{board.mention} *(board channel - no channel set)*"
        else:
            ch_text = "*not set*"
        role_text = f"<@&{cfg['role_id']}>" if cfg["role_id"] else "*no role ping*"
        p = ctx.clean_prefix
        t = tier.lower()
        embed = discord.Embed(title=f"{tier_emoji}  {tier} notifications", colour=color)
        embed.add_field(name="📢 Channel", value=ch_text, inline=True)
        embed.add_field(name="🔔 Role", value=role_text, inline=True)
        embed.set_footer(text=f"{p}{t} #channel  •  {p}{t} ping @role  •  {p}{t} off  •  {p}{t} ping off")
        await ctx.send(embed=embed, allowed_mentions=discord.AllowedMentions.none())

    async def _tier_channel(self, ctx, tier, target):
        target = (target or "").strip()
        if not target:
            return await self._tier_show(ctx, tier)
        _, tier_emoji = TIER_STYLE[tier]

        if target.lower() in OFF_WORDS:
            self._set_cfg(ctx.guild.id, tier, channel_id=None)
            return await ctx.send(f"{tier_emoji} {tier} channel removed.")

        cid = parse_channel_id(target)
        channel = ctx.guild.get_channel_or_thread(cid) if cid else None
        if channel is None or not hasattr(channel, "send"):
            return await ctx.send("I couldn't find that channel in this server. "
                                  "Use a `#channel` mention, a channel ID or a channel link.")
        perms = channel.permissions_for(ctx.guild.me)
        if not (perms.view_channel and perms.send_messages and perms.embed_links):
            return await ctx.send(f"I need **View Channel**, **Send Messages** and **Embed Links** in "
                                  f"{channel.mention} first.")

        self._set_cfg(ctx.guild.id, tier, channel_id=channel.id)
        await ctx.send(f"{tier_emoji} {tier} egg notifications will be sent in {channel.mention}.")

    async def _tier_ping(self, ctx, tier, text):
        text = (text or "").strip()
        p = ctx.clean_prefix
        if not text:
            return await ctx.send(f"Usage: `{p}{tier.lower()} ping @role` (or `{p}{tier.lower()} ping off`)")
        _, tier_emoji = TIER_STYLE[tier]

        if text.lower() in OFF_WORDS:
            self._set_cfg(ctx.guild.id, tier, role_id=None)
            return await ctx.send(f"{tier_emoji} {tier} role ping removed.")

        try:
            role = await commands.RoleConverter().convert(ctx, text)
        except commands.BadArgument:
            return await ctx.send("I couldn't find that role. Mention it (`@role`) or use its name/ID.")

        self._set_cfg(ctx.guild.id, tier, role_id=role.id)
        msg = f"{tier_emoji} I will ping {role.mention} when a **{tier}** egg spawns."
        cfg = self._get_cfg(ctx.guild.id, tier)
        if cfg["channel_id"] is None:
            msg += f"\n*(No channel set yet. I'll use the egg board channel. Set one with `{p}{tier.lower()} #channel`.)*"
        if not role.mentionable and not ctx.guild.me.guild_permissions.mention_everyone:
            msg += ("\n⚠️ That role isn't mentionable and I don't have **Mention Everyone**, "
                    "so the ping won't work until one of those is changed.")
        await ctx.send(msg, allowed_mentions=discord.AllowedMentions.none())

