        self.chosen = []
        self.result = None      # (multiplier, final money/s)
        self.message = None
        self._sync_select()

    # ---------- plumbing ----------
    async def interaction_check(self, interaction):
        if interaction.user.id != self.owner_id:
            await interaction.response.send_message("This box isn't yours. Run `!mutate` yourself.",
                                                    ephemeral=True)
            return False
        return True

    async def on_timeout(self):
        for child in self.children:
            child.disabled = True
        if self.message:
            try:
                await self.message.edit(view=self)
            except discord.HTTPException:
                pass

    def _sync_select(self):
        """Keep the dropdown ticks in sync with self.chosen."""
        self.pick.options = [
            discord.SelectOption(label=n, description=f"x{v[0]:g} multiplier", emoji=v[1],
                                 default=(n in self.chosen))
            for n, v in MUTATIONS.items()
        ]

    async def refresh(self, interaction):
        self._sync_select()
        await interaction.response.edit_message(embed=self.build_embed(), view=self)

    # ---------- the box ----------
    def build_embed(self):
        top = max(self.chosen, key=lambda n: MUTATIONS[n][0]) if self.chosen else None
        embed = discord.Embed(title="🧬  Mutate",
                              colour=MUTATIONS[top][2] if top else MUTATE_DEFAULT_COLOR)
        embed.set_author(name="Mutation Calculator")
        embed.set_thumbnail(url=DEFAULT_BANNER)

        s1 = "✅" if self.base else "⬜"
        s2 = "✅" if self.chosen else "⬜"
        s3 = "✅" if self.result else "⬜"
        embed.description = f"{s1} **Money/s**  ›  {s2} **Mutations**  ›  {s3} **Calculate**"

        embed.add_field(name="💰 Money/s",
                        value=f"**{money_fmt(self.base)}**" if self.base else "*not set*", inline=True)
        embed.add_field(name="🧪 Mutations",
                        value="  ".join(f"{MUTATIONS[n][1]} **{n}**" for n in self.chosen)
                        or "*none selected*", inline=True)

        if self.result:
            mult, final = self.result
            lines = [f"{MUTATIONS[n][1]} **{n}** ×{MUTATIONS[n][0]:g}  ➜  `+{money_fmt(self.base * (MUTATIONS[n][0] - 1))}`"
                     for n in self.chosen]
            embed.add_field(name="✨ Breakdown", value="\n".join(lines), inline=False)
            embed.add_field(name="📈 Result",
                            value=f"```{money_fmt(final)}```{boost_bar(mult)}  **x{mult:g} boost**",
                            inline=False)
            embed.add_field(name="⏱️ Per minute", value=f"**{money_fmt(final * 60, False)}**", inline=True)
            embed.add_field(name="🕒 Per hour", value=f"**{money_fmt(final * 3600, False)}**", inline=True)
            embed.set_footer(text=f"{money_fmt(self.base)} × {mult:g}  •  bonuses add up from the original")
        else:
            embed.set_footer(text="1.) Enter the [Sell] zone  •  2.) Press [Eggs]  •  3.) input Egg's M/s")
        return embed

    # ---------- controls ----------
    @discord.ui.button(label="Enter Money/s", style=discord.ButtonStyle.primary, emoji="💰", row=0)
    async def enter(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.send_modal(MutateModal(self))

    @discord.ui.button(label="Calculate", style=discord.ButtonStyle.success, emoji="🧮", row=0)
    async def calc(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not self.base:
            return await interaction.response.send_message(
                "Press **Enter Money/s** first.", ephemeral=True)
        if not self.chosen:
            return await interaction.response.send_message(
                "Pick at least one mutation first.", ephemeral=True)
        mult = stack_multiplier(self.chosen)
        self.result = (mult, self.base * mult)
        await self.refresh(interaction)

    @discord.ui.button(label="Reset", style=discord.ButtonStyle.secondary, emoji="🔄", row=0)
    async def reset(self, interaction: discord.Interaction, button: discord.ui.Button):
        self.base, self.chosen, self.result = None, [], None
        await self.refresh(interaction)

    @discord.ui.select(placeholder="Choose the egg's mutations (pick all that apply)",
                       min_values=0, max_values=len(MUTATIONS),
                       options=[discord.SelectOption(label=n) for n in MUTATIONS], row=1)
    async def pick(self, interaction: discord.Interaction, select: discord.ui.Select):
        self.chosen = list(select.values)
        self.result = None
        await self.refresh(interaction)


