def norm(s):
    """Same rule as norm() in the Lua script: lowercase, strip spaces/_/-"""
    return re.sub(r"[\s_\-]", "", str(s).lower())


def E(display, *aliases):
    """One egg. Add aliases when the game's internal name differs from the display name."""
    keys = [norm(display)] + [norm(a) for a in aliases]
    return (display, tuple(dict.fromkeys(keys)))


