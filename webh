# Countdown progress bar. The 5-minute reroll cycle is divided into
# 10 half-minute steps, so each 30-second refresh removes 10 percentage points.
def countdown_bar(cycle_end, total=REROLL_INTERVAL, width=10):
    if not cycle_end:
        return "▱" * width, 0

    remaining = max(0.0, cycle_end - time.time())
    percent = round((remaining / total) * 100 / 10) * 10 if total else 0
    percent = max(0, min(100, percent))
    filled = round(width * percent / 100)
    filled = max(0, min(width, filled))
    bar = "▰" * filled + "▱" * (width - filled)
    return bar, percent

def fmt_countdown(seconds):
    """3725 -> '1h 2m', 250 -> '4m 10s', 45 -> '45s'"""
    seconds = int(max(0, seconds))
    h, r = divmod(seconds, 3600)
    m, sec = divmod(r, 60)
    if h:
        return f"{h}h {m}m" if m else f"{h}h"
    if m:
        return f"{m}m {sec}s" if sec else f"{m}m"
    return f"{sec}s"


