local lastSeenSig = nil
local lastSentSig = nil
local changedAt   = nil

task.spawn(function()
    while true do
        pcall(function()
            local zones, total, sig = buildStatus()

            if sig ~= lastSeenSig then
                lastSeenSig = sig
                changedAt = os.clock()
                print("[EGG STATUS] change detected, sending in " .. SEND_DELAY .. "s")
            end

            if changedAt and (os.clock() - changedAt) >= SEND_DELAY then
                changedAt = nil
                if sig ~= lastSentSig then
                    lastSentSig = sig
                    sendStatus(zones, total)
                    print(string.format("[EGG STATUS] sent (%d ON)", total))
                end
            end
        end)
        task.wait(CHECK_INTERVAL)
    end
end)

