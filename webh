        self.view = view
        if view.base:
            self.money.default = money_fmt(view.base, per_second=False)

    async def on_submit(self, interaction: discord.Interaction):
        value = parse_money(self.money.value)
        if value is None or value <= 0:
            return await interaction.response.send_message(
                "Enter a Money/s value like `30B`, `250M` or `1.5T`.", ephemeral=True)
        self.view.base = value
        self.view.result = None
        await self.view.refresh(interaction)


class MutateView(discord.ui.View):
