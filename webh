    postWebhook(WEBHOOKS[tier], {
        username         = BOT_NAME,
        avatar_url       = (BOT_AVATAR ~= "") and BOT_AVATAR or nil,
        content          = mention .. " " .. style.emoji .. " **" .. name .. "** just spawned!",
        allowed_mentions = { parse = { "roles" } },
        embeds = {{
            title       = style.emoji .. "  " .. style.title .. "  " .. style.emoji,
            description = "*" .. style.tag .. "*",
            color       = style.color,
            fields = {
                { name = "🥚 Egg",    value = "**" .. name .. "**", inline = true },
                { name = "💎 Rarity", value = "**" .. tier .. "**", inline = true },
                { name = "⏱️ Time Lapsed", value = "**<t:" .. now .. ":R>**", inline = true },
                { name = "🎮 GAME NAME", value = "```" .. GAME_NAME .. "```", inline = false },
            },
            footer    = { text = "https://discord.gg/hTNwM78Qg2 • " .. tier .. " Alert" },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", now),
        }},
    })
end

