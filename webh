local function validUrl(u)

    return type(u) == "string"
        and u:find("discord.com/api/webhooks/", 1, true) ~= nil

end


local function postWebhook(url, payload)

    if not httpRequest then
        warn("[EGG] No HTTP request function found in this executor.")
        return
    end

    if not validUrl(url) then
        warn("[EGG] Webhook not set or invalid.")
        return
    end

    pcall(function()

        httpRequest({
            Url     = url,
            Method  = "POST",

            Headers = {
                ["Content-Type"] = "application/json"
            },

            Body = HttpService:JSONEncode(payload),
        })

    end)

end


local function norm(s)

    return tostring(s)
        :lower()
        :gsub("[%s_%-]", "")

end


local function pretty(s)

    return tostring(s)
        :gsub("(%l)(%u)", "%1 %2")

end


