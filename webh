for _zone, _entries in LAST_SEEN_BOARD.items():
    _base = _as_of_ts(LAST_SEEN_AS_OF_OVERRIDES[_zone]) if _zone in LAST_SEEN_AS_OF_OVERRIDES else _AS_OF
    for _name, _txt in _entries.items():
