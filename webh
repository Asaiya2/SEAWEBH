    @commands.command(name="eggcheck")
    @commands.guild_only()
    @commands.has_permissions(administrator=True)
    async def eggcheck(self, ctx):
        feed = self._feed()
        counts = json.loads(feed["counts"]) if feed.get("counts") else {}

        # every zone should hold about 5 eggs (Angels/Demons up to 6). A short zone = missing names.
        zone_lines = []
        for zone, eggs in CATALOG.items():
            if zone == "Dr Scramble":
                continue
            total = sum(counts.get(k, 0) for _, keys in eggs for k in keys)
            flag = "✅" if total >= 5 else "⚠️ short"
            zone_lines.append(f"{zone}: **{total}** {flag}")

        unknown = sorted(self._unknown.items())
        unknown_text = ", ".join(f"`{name}` x{n}" for name, n in unknown) or "none ✅"

        by_name, by_norm = self._emoji_maps()
        missing = [d for eggs in CATALOG.values() for d, keys in eggs
                   if not self._emoji_for(d, keys, by_name, by_norm)[1]]

        text = (
            "**Eggs per zone** (should be 5, Angels/Demons up to 6):\n"
            + "\n".join(zone_lines)
            + "\n\n**Names the game sent that aren't on the board** (these are your missing eggs):\n"
            + unknown_text
            + "\n\n**Eggs still using the default 🥚 (no emoji set or not found):**\n"
            + (", ".join(missing) or "none ✅")
        )
        await ctx.send(text[:1990])


